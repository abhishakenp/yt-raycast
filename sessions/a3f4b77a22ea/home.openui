$page = "Home"
root = PageSwitch(["Home","Generate","Gallery","About"], [home, p1, p2, p3])
p3 = AboutKimiPage("DreamCanvas", ["Home","Generate","Gallery","About"], {"eyebrow":"Our Vision","heading":"DreamCanvas","highlight":"Turn words into stunning images with AI","subheading":"Empowering creators, marketers, and designers to generate high‑quality visuals instantly.","primaryCta":"Start Generating","secondaryCta":"Explore the Gallery"}, {"eyebrow":"Our Journey","heading":"From Idea to Art","description":"Founded in 2021, DreamCanvas combines cutting‑edge diffusion models with an intuitive interface to make AI‑generated art accessible to anyone.","imageAlt":"Founder Maya sketching the first prototype","badge":"Founded 2021","paragraphs":["After months of research on diffusion networks, our team built a platform that can interpret natural language prompts and render photorealistic or stylized images in seconds.","The service now supports over 10,000 daily active creators, helping brands launch campaigns faster and designers prototype concepts without costly software."],"quote":"We wanted to democratize visual creation—now anyone can turn imagination into reality."}, {"eyebrow":"Core Values","heading":"Guiding Principles","description":"Our culture is built around creativity, transparency, and responsibility.","items":[{"title":"Creativity","description":"We push the boundaries of generative AI to inspire limitless artistic expression."},{"title":"Reliability","description":"99.9% uptime ensures your projects never stall."},{"title":"Privacy","description":"All prompts and outputs are encrypted and never sold to third parties."},{"title":"Community","description":"We host weekly workshops and a vibrant Discord for creators."},{"title":"Innovation","description":"Continuous model upgrades keep you ahead of visual trends."},{"title":"Sustainability","description":"Our compute infrastructure offsets carbon emissions."}]}, {"eyebrow":"By the Numbers","heading":"Our Impact","description":"Trusted by innovators worldwide.","items":[{"value":"1.2M","label":"Images Generated"},{"value":"250K","label":"Active Users"},{"value":"98%","label":"Customer Satisfaction"},{"value":"15","label":"Countries Served"},{"value":"4.5","label":"Average Prompt Success Rate"},{"value":"$3M","label":"Annual Revenue"}]}, {"eyebrow":"Leadership","heading":"Meet the Makers","description":"A blend of AI researchers, product designers, and visionaries.","members":[{"name":"Maya Patel","role":"Co‑Founder & CEO","bio":"Former ML researcher at OpenAI, Maya leads product vision and strategy.","imageAlt":"Portrait of Maya Patel"},{"name":"Luis Gomez","role":"Chief Technology Officer","bio":"Architect of the diffusion pipeline, Luis ensures the platform stays cutting‑edge.","imageAlt":"Portrait of Luis Gomez"},{"name":"Aisha Rahman","role":"Head of Design","bio":"Design systems guru, Aisha crafts the seamless user experience.","imageAlt":"Portrait of Aisha Rahman"},{"name":"Tom Becker","role":"Head of Community","bio":"Builds and nurtures the creator community across Discord and webinars.","imageAlt":"Portrait of Tom Becker"},{"name":"Jin Lee","role":"Lead Engineer","bio":"Optimizes cloud infrastructure for low‑latency image rendering.","imageAlt":"Portrait of Jin Lee"},{"name":"Sara Kim","role":"Product Manager","bio":"Bridges user feedback with roadmap priorities.","imageAlt":"Portrait of Sara Kim"}]}, {"heading":"Ready to Create?","subheading":"Join thousands of creators who turn text into breathtaking visuals.","primaryCta":"Start Your Free Trial","secondaryCta":"Book a Demo"}, {"copyright":"© 2024 DreamCanvas. All rights reserved.","links":["Privacy Policy","Terms of Service","Contact","Careers"]})
p2 = PortfolioKimiPage("DreamCanvas", ["Home","Generate","Gallery","About"], "Sign Up", {eyebrow:"AI Artistry",headlineLead:"Turn",headlineAccent:"words",headlineTail:"into stunning images",description:"DreamCanvas generates high‑resolution artworks from simple text prompts, perfect for marketers, creators, and designers seeking instant visual content.",primaryCta:"Start Creating",secondaryCta:"Explore Gallery",reel
home = AiProductKimiPage7("DreamCanvas", ["Home","Generate","Gallery","About"], {hero:{badge:"Beta",headingTop:"Turn words into",headingBottom:"stunning images",subheading:"AI-powered image generation for marketers, designers, and creators",primaryCta:"Start Creating",secondaryCta:"Watch Demo",trust:["TechCrunch","FastCompany","The Verge","Forbes"],previewFile:"preview.mp4",previewIntro:"See the magic in seconds",previewQuote:"\"It transformed my concepts into visuals instantly.\"",previewOptions:["Style: Photorealistic","Resolution: 4K","Aspect Ratio: 16:9"],previewUserMsg:"Generate your masterpiece",previewUserAlt:"Generated artwork preview",floatingLabel:"Live Prompt",floatingSub:"Type any description and watch it render"},logos:{label:"Trusted by",items:["Adobe","Canva","Shopify","HubSpot","Mailchimp"]},features:{heading:"Why DreamCanvas stands out",description:"Powerful AI models, intuitive UI, and seamless integrations empower you to create professional visuals without any design skills.",items:[{title:"Instant Rendering",description:"Generate high‑resolution images in under 5 seconds."},{title:"Style Templates",description:"Choose from 30+ artistic styles and moods."},{title:"Batch Generation",description:"Create up to 20 variations with a single prompt."},{title:"Brand Kit Sync",description:"Keep colors and fonts consistent with your brand assets."},{title:"API Access",description:"Integrate image generation into your apps and workflows."},{title:"Secure Cloud Storage",description:"All creations are saved encrypted for easy retrieval."}]},steps:{heading:"How it works",description:"From idea to image in three simple steps.",items:[{title:"Enter Prompt",description:"Describe what you need – a product shot, illustration, or abstract concept."},{title:"Select Settings",description:"Pick style, resolution, and aspect ratio to match your vision."},{title:"Download & Share",description:"Get the finished image instantly and export to any format."}]},gallery:{heading:"Gallery",description:"Explore creations from our community.",items:[{title:"Urban Futurism",description:"A neon‑lit cityscape imagined by a marketer.",imageAlt:"Neon city skyline generated by DreamCanvas"},{title:"Organic Skincare",description:"Product mockup with soft lighting and natural textures.",imageAlt:"Skincare bottle mockup generated by DreamCanvas"},{title:"Fantasy Book Cover",description:"Illustrated cover art for a fantasy novel.",imageAlt:"Fantasy book cover illustration generated by DreamCanvas"}]},pricing:{heading:"Pricing that fits creators",description:"Choose the plan that matches your workflow. No hidden fees.",plans:[{name:"Starter",tagline:"For hobbyists",price:"$19",period:"month",cta:"Start Free Trial",featured:false,features:["200 images/mo","Standard styles","Community support"],missingFeatures:["Priority support","API access"]},{name:"Pro",tagline:"For growing teams",price:"$49",period:"month",cta:"Go Pro",featured:true,features:["2,000 images/mo","All styles","API access","Priority support"],missingFeatures:[]},{name:"Enterprise",tag
p1 = MobileAppKimiPage3("DreamCanvas", ["Home","Generate","Gallery","About"], {badge:"Beta",headingTop:"DreamCanvas",headingAccent:"Generate",subheading:"Turn any text prompt into a vivid image in seconds",primaryCta:"Start Creating",secondaryCta:"Explore Gallery",appStoreRating:"4.8 ★",googlePlayRating:"4.7 ★",streakValue:"7",streakLabel:"Day Streak",joinedLabel:"Since 2024"}, {label:"Featured In",items:["TechCrunch","Wired","The Verge","FastCompany","Mashable"]}, {heading:"Powerful Features",description:"Create, edit, and share AI‑generated artwork with tools designed for creators",items:[{title:"Text‑to‑Image",description:"Describe what you imagine and watch the AI paint it instantly"},{title:"Style Transfer",description:"Apply famous art styles to your creations with one click"},{title:"Batch Generation",description:"Generate up to 20 variations from a single prompt"},{title:"Community Gallery",description:"Browse and remix popular creations from other users"},{title:"Prompt Library",description:"Save, organize, and reuse your favorite prompts"},{title:"Export Options",description:"Download in PNG, JPG, or SVG and share to social media"}]}, {heading:"How It Works",description:"Three simple steps to bring your ideas to life",items:[{title:"Enter Prompt",description:"Write a detailed description of the image you want",imageAlt:"User typing a prompt into a text box"},{title:"AI Generates",description:"Our model creates a high‑resolution image in seconds",imageAlt:"AI rendering a colorful artwork"},{title:"Download & Share",description:"Save the image or post it directly to your favorite platforms",imageAlt:"User clicking download and sharing buttons"}]}, {heading:"Inspiration Gallery",items:["Dreamy Forest","Futuristic Cityscape","Surreal Portrait","Neon Night Market","Abstract Geometry","Cosmic Ocean"]}, {heading:"Choose Your Plan",description:"Flexible pricing for creators of every level",note:"Free trial includes 10 images per month",tiers:[{name:"Free",price:"$0",period:"month",tagline:"Start for free",cta:"Start Free",featured:false,features:["10 images/month","Basic prompts","Community access"]},{name:"Pro",price:"$19",period:"month",tagline:"For serious creators",cta:"Go Pro",featured:true,features:["200 images/month","Advanced prompts","Priority support","Export in SVG"]},{name:"Team",price:"$49",period:"month",tagline:"Collaboration made easy",cta:"Contact Sales",featured:false,features:["Unlimited images","Team libraries","Admin dashboard","Dedicated account manager"]}]}, {items:[{value:"1.2M",label:"Images Generated"},{value:"85,000",label:"Active Users"},{value:"12,000",label:"Saved Prompts"}]}, {heading:"What Creators Say",description:"Real feedback from artists using DreamCanvas",items:[{quote:"DreamCanvas turned my vague ideas into stunning artwork instantly.",name:"Lena Ortiz",role:"Digital Illustrator",avatarAlt:"Portrait of Lena Ortiz"},{quote:"The batch generation saved me hours of work for client projects.",name:"Mark Chen",role:"Freelance Designer",avatarAlt:"Portrait of Mark Chen"},{quote:"I love sharing my creations directly to Instagram from the app.",name:"Aisha Khan",role:"Social Media Creator",avatarAlt:"Portrait of Aisha Khan"},{quote:"The style transfer feature gives my pieces a professional look.",