$page = "Home"
root = PageSwitch(["Home","Destinations","Packing","Gallery"], [home, p1, p2, p3])
home = BlogKimiPage("EcoVoyage", ["Home","Destinations","Packing","Gallery"], {title: "Inspiring sustainable journeys, one adventure at a time.", viewAll: "All Stories"}, {badge: "Featured", topic: "Sustainable Travel", title: "Zero‑Waste Trekking in Patagonia", excerpt: "Discover how to explore the rugged beauty of Patagonia while leaving no trace, from reusable gear to carbon‑offset hikes.", author: "Lena Rivera", readTime: "5 min read", date: "September 12, 2024", readLabel: "Read article", alt: "Patagonia landscape with hikers"}, [{tag: "Eco‑Tips", title: "5 Ways to Reduce Plastic on the Road", excerpt: "Swap single‑use bottles for a stainless steel flask, bring reusable cutlery, and choose bulk toiletries to cut waste dramatically.", author: "Jamal Ortega", date: "September 10, 2024", alt: "Reusable travel bottle on a train seat"}, {tag: "Destination", title: "Cycling the Amalfi Coast: A Green Adventure", excerpt: "Experience the cliff‑side villages by bike, stay in solar‑powered B&Bs, and support local farms for farm‑to‑table meals.", author: "Sofia Chen", date: "September 8, 2024", alt: "Cyclist overlooking Amalfi sea"}, {tag: "Gear", title: "Best Sustainable Backpacks for 2024", excerpt: "We reviewed backpacks made from recycled ocean plastics and vegan leather, focusing on durability and repairability.", author: "Aria Patel", date: "September 5, 2024", alt: "Eco-friendly backpack on a trail"}, {tag: "Story", title: "Volunteer Reef Restoration in Belize", excerpt: "Join marine biologists to plant coral fragments, learn about marine ecosystems, and contribute to thriving reefs.", author: "Miguel Alvarez", date: "August 30, 2024", alt: "Diver placing coral in Belize waters"}, {tag: "Eco‑Tips", title: "Carbon‑Offset Flights: How to Choose Credible Programs", excerpt: "A step‑by‑step guide to verify certification, calculate emissions, and support projects that truly reduce CO2.", author: "Nadia Hassan", date: "August 28, 2024", alt: "Airplane over forest with carbon offset badge"}, {tag: "Destination", title: "Eco‑Lodges of Bhutan: Culture Meets Conservation", excerpt: "Explore monasteries, hike pristine valleys, and stay in lodges powered by hydro‑electricity and local agriculture.", author: "Tashi Wangchuk", date: "August 20, 2024", alt: "Bhutanese lodge surrounded by mountains"}], {links: ["About","Contact","Privacy Policy","Terms of Service"], copyright: "© 2024 EcoVoyage. All rights reserved."})
p3 = PhotographyKimiPage("EcoVoyage", ["Home","Destinations","Packing","Gallery"], {"hero":{"kicker":"Explore the Wild","heading":"EcoVoyage Gallery","subheading":"Discover breathtaking moments from our sustainable travel adventures across the globe.","primaryCta":"Book a Trip","secondaryCta":"View Destinations","imageAlt":"Panoramic view of a misty rainforest waterfall"},"logos":{"label":"As Seen In","items":["National Geographic","Lonely Planet","Travel + Leisure","Conde Nast Traveler","BBC Earth"]},"approach":{"kicker":"Our Vision","heading":"Travel Light, Leave No Trace","description":"We pair skilled photographers with eco‑friendly itineraries, capturing nature’s beauty while championing conservation.","imageAlt":"Photographer crouching beside a sea turtle hatchling","statValue":"12","statLabel":"Years of Sustainable Exploration","features":[{"title":"Carbon‑Neutral Expeditions","description":"Every journey offsets emissions through reforestation projects."},{"title":"Community Partnerships","description":"We collaborate with local guides to support economies and preserve traditions."},{"title":"Ethical Storytelling","description":"Images are shared with permission, honoring the cultures and ecosystems featured."}]},"gallery":{"kicker":"Featured Adventures","heading":"Moments of Pure Wonder","description":"From sunrise peaks to hidden lagoons, each photo tells a story of responsible travel.","viewAll":"See All Photos","items":[{"title":"Golden Sunrise Over Kilimanjaro","location":"Tanzania","imageAlt":"Sunrise casting gold over Mount Kilimanjaro's snow cap"},{"title":"Bioluminescent Bay","location":"Puerto Rico","imageAlt":"Glowing water illuminated by biolum
p1 = BlogKimiPage2("EcoVoyage",["Home","Destinations","Packing","Gallery"],["EcoVoyage launches new carbon‑neutral ferry service!","Travel tip: Refillable water bottles cut waste by 30%","New guide: Iceland's geothermal hot springs sustainable routes"],{badge:"Featured",topic:"Sustainable Travel",date:"September 12, 2024",readTime:"5 min",title:"Exploring the Eco‑Friendly Fjords of Norway",excerpt:"Discover how Norway’s fjord tours are leading the way with electric boats, local sourcing, and zero‑waste policies.",author:"Lena Sørensen",authorRole:"Travel Writer",alt:"Norwegian fjord with electric boat",authorAlt:"Portrait of Lena Sørensen"},{title:"Explore by Theme",viewAll:"View all destinations",chips:["Eco‑Lodges","
p2 = BlogPostKimiPage("EcoVoyage", ["Home","Destinations","Packing","Gallery"], {category:"Packing", title:"Sustainable Packing Checklist for Eco-Conscious Travelers", dek:"Your complete guide to packing light, green, and ready for adventure, with reusable gear and zero‑waste tips.", authorName:"Lena Green", authorRole:"Travel Writer", authorAvatarAlt:"Portrait of Lena Green", date:"July 12, 2024", readTime:"6 min read"}, {imageAlt:"Eco-friendly travel gear laid out on a wooden table", caption:"Gear up responsibly with reusable and low-impact essentials."}, ["Traveling sustainably starts with what you pack. This checklist helps you minimize waste, reduce weight, and travel lighter while keeping your adventure comfortable and enjoyable.", "From reusable containers to versatile clothing, every item is chosen to lower your environmental footprint without compromising on experience."], [{heading:"Essentials", blocks:[{p:"Begin with a sturdy, reusable suitcase or travel backpack made from recycled materials. Look for certifications like Global Recycled Standard to ensure genuine sustainability.", items:["Reusable suitcase or backpack","Packing cubes made from recycled polyester","Travel-sized refillable toiletry bottles"]}]} ,{heading:"Zero‑Waste Toiletries", blocks:[{h3:"Bathroom Basics", p:"Swap disposable toiletries for solid alternatives and refillable containers.", items:["Solid shampoo bar","Bamboo toothbrush","Reusable silicone travel bottles","Eco-friendly floss"]},{callout:"Tip: Pack a small, biodegradable soap bar to clean dishes or clothes on the go."}]},{heading:"Smart Clothing Choices", blocks:[{p:"Choose versatile, layerable pieces made from organic cotton, Tencel, or recycled fibers. Pack items that can serve multiple functions.", items:["Merino wool base layer","Organic cotton tee","Recycled polyester rain jacket","Convertible hiking pants"]}]},{heading:"Food & Drink", blocks:[{p:"Bring reusable food storage to avoid single‑use plastics.", items:["Collapsible silicone food containers","Stainless steel water bottle","Reusable cutlery set","Beeswax food wraps"]},{imageAlt:"Collapsible silicone containers and a stainless steel bottle packed in a backpack", caption:"Compact, reusable food gear fits neatly into any bag."}]},{heading:"Travel Gadgets", blocks:[{p:"Select low‑energy gadgets and power solutions.", items:["Solar-powered charger","Energy‑efficient LED headlamp","Compact power bank with recycled casing"]}]}], {quote:"The less you bring, the lighter your footprint—and the lighter your luggage.", attribution:"Lena Green, EcoVoyage"}, ["Ready to pack smarter? Download our printable checklist and start planning your next eco‑friendly adventure today."], ["Sustainable Travel","Packing Tips","Zero Waste","Eco-Friendly Gear"], {name:"Lena Green", bio:"Lena travels the world seeking low-impact experiences, sharing practical guides that help fellow adventurers protect the planet.", avatarAlt:"Portrait of Lena Green smiling with a backpack", links:["Twitter","Instagram"]}, {heading:"You Might Also Like", items:[{category:"Destinations", date:"June 28, 2024", title:"Top 10 Eco-Friendly Destinations for 2024", excerpt:"Explore places that prioritize conservation, community, and sustainable tourism practices.", imageAlt:"Lush rainforest canopy over a sustainable eco-lodge"},{category:"Packing", date:"May 15, 2024", title:"Zero‑Waste Travel Toiletries Checklist", excerpt:"A quick reference for ditching disposable bathroom items while on the road.", imageAlt:"Travel bag with refillable bottles and solid soap bars"},{category:"Guides", date:"April 22, 2024", title:"How to Offset Your Carbon Footprint on Flights", excerpt:"Step‑by‑step guide to calculating and offsetting travel emissions responsibly.", imageAlt:"Airplane silhouette over a green earth"}]}, {heading:"Stay Updated on Green Adventures", description:"Join our community for weekly tips, destination spotlights, and sustainable travel stories delivered straight to your inbox.", placeholder:"Enter your email", submit:"Subscribe", foot