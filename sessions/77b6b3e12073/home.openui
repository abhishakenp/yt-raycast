$page = "Home"
root = PageSwitch(["Home","Post","About"], [home, p1, p2])
p1 = BlogPostKimiPage("PawPress", ["Home","Post","About"], {category:"Dog Health",title:"Why Regular Dental Check‑Ups Keep Your Dog Happy",dek:"A step‑by‑step guide to spotting dental disease early, with at‑home care tips and when to see the vet.",authorName:"Dr. Maya Torres",authorRole:"Veterinary Dentist",authorAvatarAlt:"Portrait of Dr. Maya Torres smiling with a Labrador",date:"April 12, 2024",readTime:"7 min"},{imageAlt:"Close‑up of a golden retriever's bright smile after a dental cleaning",caption:"A fresh, clean grin after a professional dental cleaning."},["Keeping your dog’s teeth healthy isn’t just about fresh breath – it’s key to overall wellness. In this article we break down the signs of dental trouble, easy daily routines, and the benefits of regular veterinary cleanings."],[{heading:"Spotting Early Warning Signs",blocks:[{p:"Look for tartar buildup, swollen gums, or a change in chewing habits. Bad breath that lingers after a walk can also be a red flag."},{h3:"Bad Breath Isn’t Just Smelly",p:"If your dog’s breath smells like rotting fish or garbage, it may indicate plaque accumulation that requires professional cleaning."}]},{quote:"A clean mouth is the gateway to a longer, happier life for our canine companions.",attribution:"Dr. Maya Torres, Veterinary Dentist"},["Remember, a quick daily tooth‑brushing routine can add years to your dog’s life. Schedule a dental exam with your vet today and keep those tail wags coming."],["Dental Care","Dog Wellness","Pet Tips"],{name:"Dr. Maya Torres",bio:"Veterinary dentist with 12 years of experience helping dogs maintain optimal oral health. Passionate about pet education and preventive care.",avatarAlt:"Dr. Maya Torres holding a dental probe next to a happy beagle",links:["Instagram","Twitter","LinkedIn"]},{heading:"You Might Also Like",items:[{category:"Training",date:"March 28, 2024",title:"Teaching Your Dog to Come When Called",excerpt:"A proven recall method that works for even the most distracted pups.",imageAlt:"Golden retriever sprinting toward
home = BlogKimiPage("PawPress",["Home","Post","About"],{title:"PawPress: Tail-wagging stories, tips & tricks for dog lovers",viewAll:"See all posts"},{badge:"Featured",topic:"Health & Wellness",title:"How to Keep Your Senior Dog Happy and Active",excerpt:"Discover gentle exercises, diet tweaks, and comfort tips that let older pups enjoy every day to the fullest.",author:"Emma Rivera",readTime:"6 min read",date:"June 5, 2024",readLabel:"Read article",alt:"Senior dog playing with a ball in a garden"},[{tag:"Training",title:"5 Positive Reinforcement Tricks Every Owner Should Know",excerpt:"Learn quick, reward‑based commands that build trust and keep your dog eager to learn.",author:"Liam Chen",date:"June 8, 2024",alt:"Dog sitting obediently for a treat"},{tag:"Nutrition",title:"The Best Grain‑Free Foods for Active Breeds",excerpt:"A deep dive into high‑protein kibble and raw options that fuel energy‑hungry pups.",author:"Sofia Patel",date:"June 7, 2024",alt:"Bowls of fresh dog food"},{tag:"Gear",title:"Top 7 Must‑Have Accessories for Summer Walks",excerpt:"From cooling vests to hands‑free leashes, gear up for safe, fun outings in the heat.",author:"Jake Monroe",date:"June 6, 2024",alt:"Dog wearing a cooling vest on a sunny path"},{tag:"Lifestyle",title:"DIY Dog‑Friendly Backyard Oasis",excerpt:"Step‑by‑step guide to creating a safe, shady retreat where your dog can lounge and play.",author:"Mia Torres",date:"June 4, 2024",alt:"Backyard with dog house and shade"}],{links:["About","Contact","Privacy Policy","Terms of Service"],copyright:"© 2024 PawPress"})
p2 = AboutKimiPage("PawPress", ["Home","Post","About"], {eyebrow:"Our Mission", heading:"Celebrating Every Tail", highlight:"Tail‑wagging stories", subheading:"PawPress brings dog lovers together with heart‑warming stories, expert tips, and a community that loves pups as much as you do.", primaryCta:"Read Our Blog", secondaryCta:"Meet the Team"}, {eyebrow:"Our Story", heading:"From a Backyard Playdate to a Global Community", description:"Founded in 2018 by two lifelong dog owners, PawPress started as a simple blog sharing the adventures of their golden retriever, Bella. Today, we reach over 250,000 dog enthusiasts each month, offering trusted advice, inspiring stories, and a platform for pet owners to connect.", imageAlt:"Founders Alex and Maya with Bella on a park bench", badge:"Founded 2018", paragraphs:["Alex and Maya noticed a gap in reliable, fun content for dog owners and decided to fill it.", "Their first post about Bella’s first birthday went viral, inspiring a community of readers who shared their own tales.", "Since then, PawPress has expanded to include expert columns, photo contests, and a thriving forum."], quote:"Dogs teach us unconditional love; we’re here to share that lesson with the world."}, {eyebrow:"Our Core Values", heading:"Guided by Love, Honesty, and Play", description:"Every article, tip, and story is built on these principles, ensuring we deliver content that’s trustworthy, joyful, and community‑focused.", items:[{title:"Compassion", description:"We put the well‑being of dogs and their families first."},{title:"Education", description:"Expert‑backed tips keep pets healthy and happy."},{title:"Community", description:"A space where every dog lover feels welcomed."},{title:"Transparency", description:"Clear, honest information without hidden agendas."},{title:"Fun", description:"Playful content that celebrates the joy of dog ownership."},{title:"Responsibility", description:"Promoting responsible pet care and adoption."}]}, {eyebrow:"By The Numbers", heading:"Our Impact", description:"Numbers that show how PawPress is making a difference for dogs and owners worldwide.", items:[{value:"250K+", label:"Monthly Readers"},{value:"1.8M+", label:"Social Media Followers"},{value:"150+", label:"Expert Contributors"},{value:"98%", label:"Satisfaction Rate"}]}, {eyebrow:"Meet the Pack", heading:"Our Team of Pet Enthusiasts", description:"