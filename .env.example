SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_STUDIO_API_TOKEN=
SANITY_STUDIO_WRITE_TOKEN=
SANITY_MANAGEMENT_TOKEN=
SANITY_CORS_EXTRA_ORIGINS=
STUDIO_SKIP_AUTO_BUILD=
SITE_SPEC_MODEL=
INTERNAL_API_SECRET=

# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk JWT issuer domain (for Convex auth)
CLERK_JWT_ISSUER_DOMAIN=

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Stripe (Convex integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_EARLY_ADOPTER_PRICE_ID=
STRIPE_CREDITS_3_PRICE_ID=
STRIPE_CREDITS_10_PRICE_ID=

# Razorpay (Convex integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_EARLY_ADOPTER_PLAN_ID=
RAZORPAY_CREDITS_3_PAISE=
RAZORPAY_CREDITS_10_PAISE=

# Environment for random prompt prefill (development, production, etc.)
NEXT_PUBLIC_NODE_ENV=development

SITE_URL=
BASE_DOMAIN=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_JURISDICTION=
PRIVACY_POLICY_EFFECTIVE_DATE=
TERMS_EFFECTIVE_DATE=
LEGAL_INCORPORATION_JURISDICTION=
LEGAL_COMPANY_REGISTRATION_NUMBER=
LEGAL_REFUND_POLICY=

BRANDFETCH_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Set to "true" to bypass export/download paywall. Omit or "false" to enforce Razorpay in dev.
DISABLE_PAYWALL=false

# Set to "true" only if legacy users must keep ZIP access from an old subscription without paying again.
EXPORT_HISTORICAL_SUBSCRIPTION_ACCESS=

SHIP_FAST_NEXT_PREVIEW=
SHIP_FAST_NEXT_PREVIEW_AUTOSTART=
SHIP_FAST_NEXT_PREVIEW_PORT=7430

# Set to "true" to disable OpenUI and use legacy HTML generation instead
DISABLE_OPENUI=false
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_API_KEY=
# Same path the Express app uses; Next `/preview/:id` reads this (must match dev:backend).
SESSIONS_DIR=./sessions

MEDUSA_ADMIN_URL=
SHIP_FAST_MEDUSA_ADMIN_EMBED=

# Multi-tenant Medusa public host. When set, each provisioned tenant is exposed
# at https://medusa-<token>.<MEDUSA_PUBLIC_HOST> via Traefik (wildcard cert
# required). Leave blank for local-only development — tenants will be reachable
# at http://localhost:<port> as before.
MEDUSA_PUBLIC_HOST=
# Traefik network that ingress joins on Dokploy / Coolify. Tenant containers
# attach to this network in addition to medusa_default so Traefik can route to
# them. Defaults to dokploy-network when MEDUSA_PUBLIC_HOST is set.
MEDUSA_PROXY_NETWORK=
# Traefik entrypoint name to bind tenant routers to (typically "websecure"
# for TLS). Override if your reverse-proxy uses a different entrypoint name.
MEDUSA_PROXY_ENTRYPOINT=
# Cert resolver name configured in Traefik (e.g. "letsencrypt"). Leave blank
# if the wildcard cert is provided by a static TLS config instead of a resolver.
MEDUSA_PROXY_CERT_RESOLVER=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_EARLY_ADOPTER_PLAN_ID=
RAZORPAY_CREDITS_3_PAISE=
RAZORPAY_CREDITS_10_PAISE=

# Stripe checkout for international users
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_EARLY_ADOPTER_PRICE_ID=
STRIPE_CREDITS_3_PRICE_ID=
STRIPE_CREDITS_10_PRICE_ID=

# Partner coupons. JSON format is preferred; each code must include a provider id
# for the payment gateway that should apply the discount.
# Example:
# SHIP_FAST_PARTNER_COUPONS=[{"code":"PARTNER20","percentOff":20,"razorpayOfferId":"offer_xxx","stripePromotionCode":"promo_xxx"}]
SHIP_FAST_PARTNER_COUPONS=

# Generation cost/follow-up notifications. Leave empty to disable.
GENERATION_COST_ALERT_USD=100
SHIP_FAST_SLACK_WEBHOOK_URL=
SHIP_FAST_TELEGRAM_BOT_TOKEN=
SHIP_FAST_TELEGRAM_CHAT_ID=
# Optional override for local tests or a Telegram-compatible gateway.
SHIP_FAST_TELEGRAM_API_BASE=

# Optional override for local GitHub export verification against a fake API.
SHIP_FAST_GITHUB_API_BASE=

# Uptime Kuma push monitor. Create a Push monitor in Kuma and paste its push URL.
# The app also exposes GET /health for HTTP monitors.
UPTIME_KUMA_PUSH_URL=
UPTIME_KUMA_PUSH_INTERVAL_MS=60000
UPTIME_KUMA_PUSH_TIMEOUT_MS=5000

# Mobbin Pro live API (optional). Import browser session once — never commit cookies:
#   MOBBIN_BROWSER_COOKIE='paste document.cookie' bun scripts/mobbin-import-browser-cookie.mjs
# Then enable live screen metadata in the ship engine:
# SHIPFAST_MOBBIN_LIVE=1
# MOBBIN_AUTH_FILE=~/.mobbin-mcp/auth.json

# IP whitelist for rate limiting bypass (comma-separated). Whitelisted IPs are not subject to:
# - Daily generation limit (2/day for anonymous users)
# - 10-minute rate limit per IP
# - Concurrent generation limit (2 at a time)
# Example: WHITELISTED_IPS=1.2.3.4,5.6.7.8,192.168.1.100
WHITELISTED_IPS=

# Express proxy trust for client IP resolution. Default is false so clients cannot spoof
# X-Forwarded-For. Set to an explicit hop count or subnet list behind a known reverse proxy.
TRUST_PROXY=
