gallery_testimonials = MembershipClubTestimonials("Hamare Fans Ka Feedback", "Kya Log Kehte Hain?", [{"name":"Riya Sharma","role":"Bollywood Enthusiast","quote":"Har mahine ki exclusive screening se meri movie cravings poori hoti hain!","avatarAlt":"Riya Sharma ki photo"},{"name":"Amit Verma","role":"Film Critic","quote":"Club ke events hamesha premium feel dete hain, bilkul cinema hall jaisa.","avatarAlt":"Amit Verma ki photo"},{"name":"Sneha Patel","role":"Student","quote":"Friends ke saath movie marathons ka maza hi alag hai, thanks to the club!","avatarAlt":"Sneha Patel ki photo"}])
