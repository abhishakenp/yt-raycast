home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_hero_anchor, home_logos_anchor, home_steps_anchor, home_stats_anchor, home_cta_anchor, home_footer_anchor])
gallery_navbar = MembershipClubNavbar("Movie Fans", ["Home","Gallery","Pricing"], "Join Abhi", "Pricing")
