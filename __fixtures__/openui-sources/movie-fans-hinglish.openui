pricing_pricing = MembershipClubPricing("Choose Your Plan", "Apni Movie Passion Ko Upgrade Karein", "Har plan ke saath milti hai exclusive screenings, early access, aur fan events ka unlimited maza. Apne budget ke hisaab se best plan pick karein.", [{"name":"Silver Fan","blurb":"Basic movie updates aur monthly newsletter","price":"₹199","period":"per month","annual":"₹1999","features":["Weekly movie news","Access to public screenings","Member-only Discord","Discounts on merch"],"cta":"Join Silver","featured":false,"badge":null},{"name":"Gold Fan","blurb":"Sabse popular plan, extra perks ke saath","price":"₹449","period":"per month","annual":"₹4499","features":["All Silver features","Early ticket booking","Quarterly exclusive screenings","Behind‑the‑scenes content"],"cta":"Go Gold","featured":true,"badge":"Most Popular"},{"name":"Platinum Fan","blurb":"Ultimate fan experience, all-access pass","price":"₹799","period":"per month","annual":"₹7999","features":["All Gold features","VIP lounge access","Annual meet‑and‑greet with stars","Personalized movie recommendations","Free merch kit"],"cta":"Become Platinum","featured":false,"badge":"Best Value"}], "Annual plans pe 2 mahine free! Cancel anytime, no hidden fees.")
pricing_pricing_anchor = SectionAnchor("pricing_pricing", pricing_pricing, "scroll-mt-28")
pricing_faq = MembershipClubFaq("Aksar Poochhe Jane Wale Sawal", "Sabhi Questions Ka Jawab Yahan Milega", [{"q":"Kya main plan ko beech mein upgrade ya downgrade kar sakta hoon?","a":"Bilkul! Aap apne dashboard se kisi bhi time plan change kar sakte hain, aur pro‑rated amount instantly adjust ho jayega."},{"q":"Mere subscription ka cancellation process kaisa hai?","a":"Simple – bas dashboard par 'Cancel Membership' click karein. Aapke current billing cycle ke end tak aapko access milta rahega."},{"q":"Kya annual plan ke liye koi trial period milta hai?","a":"Haan, hum 7‑din ka risk‑free trial offer karte hain. Trial ke baad aapko automatically annual billing mil jayegi."},{"q":"Kya membership ke saath koi hidden fees ya extra charges hain?","a":"Nahi. Jo price aap dekh rahe hain, wahi final amount hai. Sabhi taxes aur fees already included hain."}])
pricing_faq_anchor = SectionAnchor("pricing_faq", pricing_faq, "scroll-mt-28")
pricing_cta = MembershipClubCta("Abhi Join Karein Aur Movie Magic Ka Hissa Ban Jayein", "Limited seats ke liye abhi sign up karein, ya apna email daal kar exclusive updates paayein.", "Join Gold Now", "Explore Free Trial", "Enter your email", "No spam, only movie love!")
