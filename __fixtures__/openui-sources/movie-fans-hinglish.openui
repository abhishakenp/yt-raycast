home_logos_anchor = SectionAnchor("home_logos", home_logos, "scroll-mt-28")
home_steps = MembershipClubSteps("How It Works", "Simple 3 Steps", "Join, enjoy, aur apna passion share karo", [{"title":"Sign Up","description":"Apni details bhar ke free trial lein"},{"title":"Get Access","description":"Exclusive movies, events aur community forums ka access paayein"},{"title":"Connect","description":"Dusre fans ke saath discuss, review aur events attend karein"}])
home_steps_anchor = SectionAnchor("home_steps", home_steps, "scroll-mt-28")
home_stats = MembershipClubStats([{"value":"10k+","label":"Members"},{"value":"500+","label":"Screenings Hosted"},{"value":"1M+","label":"Hours of Content"}])
