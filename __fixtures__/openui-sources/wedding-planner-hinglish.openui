brand = Heading("Desi Wedding Planner", "1", "text-foreground")
budgetLabel = Text("Budget (₹):", "default", "text-foreground")
budgetInput = StateInput("budget", "Enter budget", "0")
budgetState = StateText("budget", "0", "Current Budget: ₹")
venueLabel = Text("Venue:", "default", "text-foreground")
venueInput = StateInput("venue", "Enter venue name")
baraatLabel = Text("Baraat Details:", "default", "text-foreground")
baraatInput = StateInput("baraat", "Enter baraat info")
mehendiLabel = Text("Mehendi Details:", "default", "text-foreground")
mehendiInput = StateInput("mehendi", "Enter mehendi info")
guestLabel = Text("Guest List:", "default", "text-foreground")
guestInput = StateInput("guestList", "Enter guest names")
dramaLabel = Text("Drama Control:", "default", "text-foreground")
dramaToggle = StateButton("Toggle Drama", "drama", "toggle", undefined, undefined, false, "default")
dramaState = StateText("drama", false, "Drama On: ")
dashboard = Card([budgetLabel, budgetInput, budgetState, venueLabel, venueInput, baraatLabel, baraatInput, mehendiLabel, mehendiInput, guestLabel, guestInput, dramaLabel, dramaToggle, dramaState], "Dashboard", "Manage sab kuch", [], "bg-card")
root = Stack([brand, dashboard], "col", "md", "center", "center")