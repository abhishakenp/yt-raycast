home_navbar = TravelAgencyNavbar("Create Premium", ["Home","Gallery","Services"], "+1-800-TRAVEL", "/", "Book Now", "/search")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_hero = TravelAgencyHero("Fly in Luxury", "Discover Your Next Destination", "Premium flights, curated experiences, and unbeatable service—all at your fingertips.", "Aerial view of a tropical island with a private jet", "Enter destination or airport", "Select dates", "1 Adult", "Search Flights", "/search")
home_hero_anchor = SectionAnchor("home_hero", home_hero, "scroll-mt-28")
home_services = TravelAgencyServices("What Sets Us Apart", "Tailored for the discerning traveler", [{"title":"One‑Way & Round‑Trip","description":"Flexible booking options for business trips or leisurely getaways."},{"title":"Airline Filters","description":"Choose from premium carriers, seat classes, and amenities."},{"title":"Fare Calendar","description":"Visualize the cheapest days to fly with our interactive calendar."},{"title":"Secure Checkout","description":"Fast, encrypted payment processing with multiple payment methods."},{"title":"Personalized Itinerary","description":"All flight details, e‑tickets, and travel tips in one page."}])
home_services_anchor = SectionAnchor("home_services", home_services, "scroll-mt-28")
home_overview = TravelAgencyOverview("Create Premium", "Why Choose Us", "Travel Made Elegant", "We combine cutting‑edge technology with a concierge‑level service to make every journey unforgettable.", "Start Booking", "Learn More", "Elegant airplane cabin with leather seats", ["24/7 Support","Best‑price guarantee","Hand‑picked premium airlines","Instant e‑ticket delivery"], [{"value":"1M+","label":"Flights Booked"},{"value":"98%","label":"Customer Satisfaction"},{"value":"50+","label":"Global Destinations"}])
home_overview_anchor = SectionAnchor("home_overview", home_overview, "scroll-mt-28")
home_stats = TravelAgencyStats("Our Impact", "Numbers that speak for themselves", [{"value":"2.5M","label":"Happy Travelers"},{"value":"150","label":"Airline Partners"},{"value":"4.8/5","label":"Average Rating"}])
home_stats_anchor = SectionAnchor("home_stats", home_stats, "scroll-mt-28")
home_testimonials = TravelAgencyTestimonials("What Our Travelers Say", "Real stories from real jet‑setters", [{"quote":"Create Premium turned my business trip into a first‑class experience. The fare calendar saved me $300!","name":"Laura M.","role":"Marketing Director","company":"TechNova","rating":5,"avatarAlt":"Portrait of Laura M."},{"quote":"The destination cards are stunning and the checkout was lightning fast. Highly recommend!","name":"James K.","role":"Freelance Photographer","company":"","rating":5,"avatarAlt":"Portrait of James K."},{"quote":"I loved the personalized itinerary page – everything I needed was there, from flight details to local tips.","name":"Sofia R.","role":"Travel Blogger","company":"","rating":4,"avatarAlt":"Portrait of Sofia R."}])
home_testimonials_anchor = SectionAnchor("home_testimonials", home_testimonials, "scroll-mt-28")
home_cta = TravelAgencyCta("Ready to Take Off?", "Book Your Premium Flight Today", "Experience the difference with Create Premium – luxury, speed, and peace of mind.", "Search Flights", "/search", "Contact Sales", "/contact")
home_cta_anchor = SectionAnchor("home_cta", home_cta, "scroll-mt-28")
home_footer = TravelAgencyFooter("Create Premium", "Luxury travel, simplified", [{"title":"Company","links":["About Us","Careers","Press"]},{"title":"Support","links":["Help Center","Contact Us","FAQ"]},{"title":"Legal","links":["Terms of Service","Privacy Policy"]}], [{"label":"Facebook","href":"https://facebook.com/createpremium"},{"label":"Twitter","href":"https://twitter.com/createpremium"},{"label":"Instagram","href":"https://instagram.com/createpremium"}], ["© 2026 Create Premium. All rights reserved."], "Travel responsibly. Follow local COVID‑19 guidelines.")
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_hero_anchor, home_services_anchor, home_overview_anchor, home_stats_anchor, home_testimonials_anchor, home_cta_anchor, home_footer_anchor])
gallery_navbar = TravelAgencyNavbar("Create Premium", ["Home","Gallery","Services"], "+1 (800) 555‑0199", "Home", "Book Your Flight", "Services")
gallery_navbar_anchor = SectionAnchor("gallery_navbar", gallery_navbar)
gallery_gallery = TravelAgencyGallery("Explore Our Dream Destinations", "Curated visuals of the world’s most inspiring locales, ready for your next premium flight experience.", [{"alt":"Sunset over Santorini, Greece with whitewashed buildings","caption":"Santorini – A romantic escape over the Aegean Sea"},{"alt":"Snow‑capped peaks of the Swiss Alps reflected in a crystal‑clear lake","caption":"Swiss Alps – Luxury ski resorts and serene valleys"},{"alt":"Night skyline of Tokyo with illuminated skyscrapers and Shibuya crossing","caption":"Tokyo – Vibrant city lights and cutting‑edge culture"},{"alt":"Turquoise waters and palm‑fringed beaches of the Maldives","caption":"Maldives – Private overwater villas and pristine reefs"},{"alt":"Historic streets of Marrakech with bustling souks and orange walls","caption":"Marrakech – Exotic markets and timeless architecture"}])
gallery_gallery_anchor = SectionAnchor("gallery_gallery", gallery_gallery, "scroll-mt-28")
gallery_testimonials = TravelAgencyTestimonials("What Our Travelers Say", "Real experiences from discerning globetrotters who choose SkyLux for their premium journeys.", [{"quote":"SkyLux turned a simple business trip to Zurich into a first‑class adventure. The service was flawless from check‑in to touchdown.","name":"Elena Martínez","role":"Senior Consultant","company":"GlobalTech Solutions","rating":5,"avatarAlt":"Portrait of Elena Martínez"},{"quote":"The Maldives package was beyond expectations—private lounge, seamless transfers, and a stunning villa arrival. Worth every penny.","name":"James O’Connor","role":"Travel Blogger","rating":5,"avatarAlt":"Portrait of James O’Connor"},{"quote":"Booking a round‑trip to Tokyo was effortless with the fare calendar. We secured the best seats and a complimentary lounge upgrade.","name":"Aisha Khan","role":"Entrepreneur","rating":4,"avatarAlt":"Portrait of Aisha Khan"}])
gallery_testimonials_anchor = SectionAnchor("gallery_testimonials", gallery_testimonials, "scroll-mt-28")
gallery_footer = TravelAgencyFooter("Create Premium", "Premium Flights, Curated Experiences", [{"title":"Explore","links":["Destinations","Special Offers","Travel Guides"]},{"title":"Company","links":["About Us","Careers","Press"]},{"title":"Support","links":["Contact","FAQ","Travel Policies"]}], [{"label":"Facebook","href":"https://facebook.com/SkyLuxTravels"},{"label":"Instagram","href":"https://instagram.com/SkyLuxTravels"},{"label":"Twitter","href":"https://twitter.com/SkyLuxTravels"}], ["Privacy Policy","Terms of Service","Cookie Settings"], "© 2026 SkyLux Travels. All rights reserved.")
gallery_footer_anchor = SectionAnchor("gallery_footer", gallery_footer, "scroll-mt-28")
gallery = Stack([gallery_navbar_anchor, gallery_gallery_anchor, gallery_testimonials_anchor, gallery_footer_anchor])
services_navbar = TravelAgencyNavbar("Create Premium", ["Home","Gallery","Services"], "+1 (800) 555‑0199", "Home", "Start a Quote", "Contact")
services_navbar_anchor = SectionAnchor("services_navbar", services_navbar)
services_services = TravelAgencyServices("Our Premium Services", "Tailored solutions for the discerning traveler", [{"title":"Bespoke Flight Booking","description":"Personalized itinerary planning with access to exclusive cabin classes, private lounges, and priority boarding."},{"title":"Dynamic Fare Calendar","description":"Visual calendar that highlights the lowest fares across a 90‑day window, letting you lock in the best price."},{"title":"Airline Preference Filters","description":"Filter options for airlines, aircraft type, in‑flight amenities, and loyalty program integration."},{"title":"Secure Checkout & Payment Plans","description":"PCI‑compliant checkout with split‑payment options, travel insurance add‑ons, and instant e‑ticket delivery."},{"title":"Post‑Booking Itinerary Management","description":"Real‑time updates, easy modifications, and a mobile‑first itinerary page that consolidates flights, hotels, and activities."}])
services_services_anchor = SectionAnchor("services_services", services_services, "scroll-mt-28")
services_stats = TravelAgencyStats("Why Travelers Trust Us", "Proven performance across millions of journeys", [{"value":"4.9/5","label":"Average Customer Rating"},{"value":"12,000+","label":"Premium Flights Booked Monthly"},{"value":"98%","label":"On‑time Delivery Rate"},{"value":"24/7","label":"Dedicated Support Hours"}])
services_stats_anchor = SectionAnchor("services_stats", services_stats, "scroll-mt-28")
services_cta = TravelAgencyCta("Ready to Elevate Your Travel", "Start Your Premium Journey Today", "Connect with a travel specialist and receive a customized quote within minutes.", "Get a Quote", "Contact", "Explore Our Process", "Services")
services_cta_anchor = SectionAnchor("services_cta", services_cta, "scroll-mt-28")
services_footer = TravelAgencyFooter("Create Premium", "Luxury flights, effortless experiences", [{"title":"Company","links":["About Us","Careers","Press"]},{"title":"Support","links":["Help Center","Contact","FAQ"]},{"title":"Legal","links":["Privacy Policy","Terms of Service","Cookie Policy"]}], [{"label":"Facebook","href":"https://facebook.com/skyluxtravel"},{"label":"Twitter","href":"https://twitter.com/skyluxtravel"},{"label":"Instagram","href":"https://instagram.com/skyluxtravel"}], ["© 2026 SkyLux Travel. All rights reserved."], "Travel responsibly. Prices and availability subject to change.")
services_footer_anchor = SectionAnchor("services_footer", services_footer, "scroll-mt-28")
