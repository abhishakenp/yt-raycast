home_navbar = Navbar("Pizza Delivery", ["Home"], "Order Now")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_hero = SplitHero("Craving Something Hot?", "Craving Something Hot? Pizza Delivered Fast", "Pizza Delivered Fast", "Choose from hundreds of toppings, sides, and desserts – all just a tap away.", "Find Restaurants", "Learn More", null, null, "Delicious pizza being delivered to a happy customer")
home_hero_anchor = SectionAnchor("home_hero", home_hero, "scroll-mt-28")
home_logos = LogoStrip("Trusted by Your Favorite Restaurants", ["logo_dominos.png","logo_papa_johns.png","logo_pizza_hut.png","logo_little_caesars.png","logo_local_favorites.png"])
home_logos_anchor = SectionAnchor("home_logos", home_logos, "scroll-mt-28")
home_features = FeatureList([{"heading":"Lightning Fast Delivery","description":"Average delivery time under 30 minutes in major metros."},{"heading":"Live Order Tracking","description":"Watch your pizza's journey from oven to your table in real‑time."},{"heading":"Customizable Pizzas","description":"Build your own masterpiece with over 30 toppings."},{"heading":"Easy Reorder","description":"One‑click repeat of your favorite orders."}])
home_features_anchor = SectionAnchor("home_features", home_features, "scroll-mt-28")
home_steps = StepProcess("How It Works", "Ordering your perfect pizza is as easy as 1‑2‑3.", [{"title":"Choose Your Pizza","description":"Browse menus, select size, crust, and toppings."},{"title":"Add Extras","description":"Add sides, drinks, and desserts to complete the feast."},{"title":"Track & Enjoy","description":"Pay, track your order, and enjoy hot pizza at your door."}])
home_steps_anchor = SectionAnchor("home_steps", home_steps, "scroll-mt-28")
home_restaurants = CardGrid("Popular Pizza Spots Near You", "Top-rated pizzerias ready to deliver your cravings.", [{"title":"Mario's Wood‑Fire Pizza","description":"Italian • Wood‑Fire • 4.8 ★ • 25‑30 min","imageAlt":"Mario's Wood‑Fire Pizza storefront"},{"title":"Slice City","description":"American • Thin Crust • 4.6 ★ • 20‑25 min","imageAlt":"Slice City pizza slice"},{"title":"Bella Napoli","description":"Neapolitan • Classic • 4.9 ★ • 30‑35 min","imageAlt":"Bella Napoli classic pizza"},{"title":"Urban Pie Co.","description":"Fusion • Artisan • 4.7 ★ • 28‑32 min","imageAlt":"Urban Pie Co. artisan pizza"}])
home_restaurants_anchor = SectionAnchor("home_restaurants", home_restaurants, "scroll-mt-28")
home_stats = StatsStrip([{"value":"10M+","label":"Orders Delivered"},{"value":"5,000+","label":"Partner Restaurants"},{"value":"98%","label":"Customer Satisfaction"},{"value":"30","label":"Minutes Avg. Delivery"}])
home_stats_anchor = SectionAnchor("home_stats", home_stats, "scroll-mt-28")
home_cta = CtaBand("Ready for a Slice?", "Download the app and get $5 off your first order!", "Get Started")
home_cta_anchor = SectionAnchor("home_cta", home_cta, "scroll-mt-28")
home_footer = Footer("Pizza Delivery", [{"title":"Company","links":["About Us","Careers","Blog","Press"]},{"title":"Help","links":["Support Center","FAQ","Contact Us","Privacy Policy"]},{"title":"Legal","links":["Terms of Service","Cookie Policy","Licensing"]}], ["icon_facebook.svg","icon_instagram.svg","icon_twitter.svg"])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_hero_anchor, home_logos_anchor, home_features_anchor, home_steps_anchor, home_restaurants_anchor, home_stats_anchor, home_cta_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home":"Home","home":"Home","home_navbar":"Home#home_navbar","Navbar":"Home#home_navbar","navbar":"Home#home_navbar","home_hero":"Home#home_hero","Hero":"Home#home_hero","hero":"Home#home_hero","home_logos":"Home#home_logos","Logos":"Home#home_logos","logos":"Home#home_logos","home_features":"Home#home_features","Features":"Home#home_features","features":"Home#home_features","home_steps":"Home#home_steps","Steps":"Home#home_steps","steps":"Home#home_steps","home_restaurants":"Home#home_restaurants","Restaurants":"Home#home_restaurants","restaurants":"Home#home_restaurants","home_stats":"Home#home_stats","Stats":"Home#home_stats","stats":"Home#home_stats","home_testimonials":"Home#home_testimonials","Testimonials":"Home#home_testimonials","testimonials":"Home#home_testimonials","home_cta":"Home#home_cta","Cta":"Home#home_cta","cta":"Home#home_cta","Get Started":"Home#home_cta","get started":"Home#home_cta","Start":"Home#home_cta","start":"Home#home_cta","Join":"Home#home_cta","join":"Home#home_cta","Book Now":"Home#home_cta","book now":"Home#home_cta","home_footer":"Home#home_footer","Footer":"Home#home_footer","footer":"Home#home_footer","Contact":"Home#home_cta","contact":"Home#home_cta","Contact Us":"Home#home_cta","contact us":"Home#home_cta","Terms of Service":"Home#home_cta","terms of service":"Home#home_cta"})
