home_navbar = Navbar(brand="SaaS Co", links=["Home", "Features", "Pricing", "About"], cta="Start Free")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_centeredhero = CenteredHero(heading="Build <hl>faster</hl> with analytics", subheading="Ship insights in milliseconds", primaryCta="Start Free Trial", secondaryCta="View Demo")
home_centeredhero_anchor = SectionAnchor("home_centeredhero", home_centeredhero, "scroll-mt-28")
home_cardgrid = CardGrid(eyebrow="Features", heading="Everything you need", cards=[{title: "Real-time", description: "Stream events"}, {title: "Dashboards", description: "Visualize metrics"}, {title: "Alerts", description: "Get notified"}, {title: "Integrations", description: "Connect your stack"}])
home_cardgrid_anchor = SectionAnchor("home_cardgrid", home_cardgrid, "scroll-mt-28")
home_pricingtable = PricingTable(heading="Simple pricing", tiers=[{name: "Starter", price: "$0", features: "1 project", cta: "Get started", highlighted: false}, {name: "Pro", price: "$29", features: "Unlimited", cta: "Start trial", highlighted: true}, {name: "Enterprise", price: "Custom", features: "Everything", cta: "Contact us", highlighted: false}])
home_pricingtable_anchor = SectionAnchor("home_pricingtable", home_pricingtable, "scroll-mt-28")
home_footer = Footer(brand="SaaS Co", columns=[{title: "Product", links: ["Home", "Pricing"]}, {title: "Company", links: ["About", "Contact"]}])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_centeredhero_anchor, home_cardgrid_anchor, home_pricingtable_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home": "home"})
