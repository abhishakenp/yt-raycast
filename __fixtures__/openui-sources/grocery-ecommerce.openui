gallery_gallery = EcommerceGallery("Explore Our Fresh Selections", "Premium quality produce, curated bundles, and seasonal specials", "Add to Cart", [{"name":"Organic Avocado Pack (4 pcs)","price":"$6.99","oldPrice":"$8.49","badge":"Save 18%","imageAlt":"A neatly arranged pack of ripe organic avocados on a wooden board"},{"name":"Artisan Wholegrain Bread","price":"$4.49","badge":"New Arrival","imageAlt":"Golden-brown wholegrain loaf sliced partially, showing the crumb"},{"name":"Farm Fresh Mixed Berries","price":"$9.99","oldPrice":"$12.99","badge":"Limited Stock","imageAlt":"A bowl of vibrant strawberries, blueberries, and raspberries"},{"name":"Premium Grass-Fed Beef Bundle","price":"$24.99","badge":"Best Seller","imageAlt":"Assorted cuts of marbled grass-fed beef displayed on a butcher block"},{"name":"Gourmet Cheese Sampler","price":"$19.99","oldPrice":"$22.99","badge":"Save 14%","imageAlt":"An assortment of artisan cheeses on a slate board with crackers"}])
