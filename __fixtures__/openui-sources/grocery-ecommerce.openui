gallery_testimonials = EcommerceTestimonials("What Our Customers Say", "Real feedback from shoppers who love our premium grocery experience", [{"quote":"The delivery was lightning‑fast and everything arrived perfectly fresh. The curated bundles saved me so much time!","name":"Emily R.","rating":5,"avatarAlt":"Portrait of Emily smiling"},{"quote":"I love the premium storefront – it feels like a boutique grocery. The quality of the produce is unmatched.","name":"Javier M.","rating":4,"avatarAlt":"Portrait of Javier"},{"quote":"The trust badges gave me confidence, and the order tracking kept me in the loop every step of the way.","name":"Sofia L.","rating":5,"avatarAlt":"Portrait of Sofia"}])
gallery_testimonials_anchor = SectionAnchor("gallery_testimonials", gallery_testimonials, "scroll-mt-28")
