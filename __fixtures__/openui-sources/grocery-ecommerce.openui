home_navbar = AICustom_EcommerceNavbar_home_navbar("Create Grocery", ["Home","Gallery"], null, "Shop Now", "/shop", "0")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_hero = EcommerceHero("Fresh & Fast", "Your Grocery, Delivered", "Premium quality, curated collections, and unbeatable offers", "Start Shopping", "View Offers", "Organic Fruit Basket", "$29.99", "Seasonal selection of organic fruits", "Add to Cart", "Fresh grocery assortment", "New Arrival", ["Secure Checkout","Fast Delivery","30‑Day Guarantee"])
home_hero_anchor = SectionAnchor("home_hero", home_hero, "scroll-mt-28")
home_logos = EcommerceLogos("Trusted by", [{"label":"Whole Foods"},{"label":"Kroger"},{"label":"Trader Joe's"},{"label":"Safeway"},{"label":"Local Farms"}])
home_logos_anchor = SectionAnchor("home_logos", home_logos, "scroll-mt-28")
home_features = EcommerceFeatures("Why Shop With Us?", "Premium storefront, curated collections, and seamless experience", [{"title":"Curated Collections","description":"Hand‑picked product bundles and seasonal assortments for every need."},{"title":"Fast Delivery Slots","description":"Choose a delivery window that fits your schedule, often within hours."},{"title":"Secure Payments","description":"Multiple payment options with end‑to‑end encryption."},{"title":"Real Reviews","description":"Verified customer feedback on every product."}])
home_features_anchor = SectionAnchor("home_features", home_features, "scroll-mt-28")
home_overview = EcommerceOverview("Create Grocery", "Premium Grocery Delivery", "Shop Fresh, Delivered Fast", "From farm‑fresh produce to pantry staples, everything you need in one place.", "Explore Collections", "Learn More", "Delivery van with fresh groceries", ["Same‑Day Delivery","Wide Product Range","Easy Returns"], [{"value":"10K+","label":"Satisfied Customers"},{"value":"99%","label":"On‑time Delivery"},{"value":"5M","label":"Products Delivered"}])
home_overview_anchor = SectionAnchor("home_overview", home_overview, "scroll-mt-28")
home_testimonials = EcommerceTestimonials("What Our Customers Say", "Real experiences from happy shoppers", [{"quote":"The delivery was lightning fast and the produce was incredibly fresh!","name":"Emily R.","rating":5,"avatarAlt":"Emily profile picture"},{"quote":"I love the curated bundles – they save me time and money every week.","name":"Mark T.","rating":4,"avatarAlt":"Mark profile picture"},{"quote":"Customer service resolved my issue instantly. Highly recommend!","name":"Sofia L.","rating":5,"avatarAlt":"Sofia profile picture"}])
home_testimonials_anchor = SectionAnchor("home_testimonials", home_testimonials, "scroll-mt-28")
home_footer = EcommerceFooter("Create Grocery", "Freshness Delivered to Your Doorstep", [{"title":"Shop","links":["All Products","Bundles","Offers","New Arrivals"]},{"title":"Company","links":["About Us","Careers","Press","Blog"]},{"title":"Help","links":["Contact Support","Delivery Info","Returns","FAQ"]}], [{"label":"Facebook","href":"https://facebook.com/creategrocery"},{"label":"Instagram","href":"https://instagram.com/creategrocery"},{"label":"Twitter","href":"https://twitter.com/creategrocery"}], "© 2026 Create Grocery. All rights reserved.")
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_hero_anchor, home_logos_anchor, home_features_anchor, home_overview_anchor, home_testimonials_anchor, home_footer_anchor])
