home_navbar = Navbar(brand="Studio", links=["Home", "Work", "About", "Contact"])
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_posterhero = PosterHero(heading="Visual <hl>stories</hl> that captivate", subheading="We craft brands, websites, and experiences", cta="View Work")
home_posterhero_anchor = SectionAnchor("home_posterhero", home_posterhero, "scroll-mt-28")
home_projectgallery = ProjectGallery(heading="Selected Work", projects=[{title: "Brand Identity", category: "Branding"}, {title: "E-commerce", category: "Web"}, {title: "Mobile App", category: "UI/UX"}, {title: "Editorial", category: "Print"}])
home_projectgallery_anchor = SectionAnchor("home_projectgallery", home_projectgallery, "scroll-mt-28")
home_contactform = ContactForm(heading="Let's work together", subheading="Tell us about your project")
home_contactform_anchor = SectionAnchor("home_contactform", home_contactform, "scroll-mt-28")
home_footer = Footer(brand="Studio", columns=[{title: "Studio", links: ["Home", "Work", "About"]}, {title: "Contact", links: ["hello@studio.com"]}])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_posterhero_anchor, home_projectgallery_anchor, home_contactform_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home": "home"})
