gallery_testimonials = BeautyStoreTestimonials("What Our Guests Say", "Stories Brewed in Every Cup", [{"quote":"The moment I walked in, the scent of roasted beans and the warm lighting made me feel right at home. Their latte art is pure poetry.","name":"Aisha K.","meta":"Frequent Visitor","avatarAlt":"Portrait of Aisha K., smiling coffee enthusiast"},{"quote":"I hosted a small gathering here and the staff made it unforgettable—great coffee, beautiful space, and a playlist that set the perfect mood.","name":"Liam R.","meta":"Local Blogger","avatarAlt":"Portrait of Liam R., holding a coffee cup"},{"quote":"Their seasonal blends are a work of art. The tasting flight in the gallery area let me discover new flavors I’d never imagined.","name":"Sofia M.","meta":"Coffee Connoisseur","avatarAlt":"Portrait of Sofia M., tasting a coffee"}])
