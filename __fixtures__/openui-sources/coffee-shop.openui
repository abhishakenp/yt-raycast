home_navbar = Navbar("Coffee Co", ["Home", "Menu", "About", "Contact"], "Order Now")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_splithero = SplitHero("Fresh daily", "We roast perfect coffee", undefined, "Small-batch beans from around the world", "Order Now", "Our Story")
home_splithero_anchor = SectionAnchor("home_splithero", home_splithero, "scroll-mt-28")
home_cardgrid = CardGrid("What we do", "Our craft", undefined, [{title: "Espresso", description: "Double shot intensity"}, {title: "Pour Over", description: "Slow extraction"}, {title: "Cold Brew", description: "24hr steeped"}])
home_cardgrid_anchor = SectionAnchor("home_cardgrid", home_cardgrid, "scroll-mt-28")
home_footer = Footer("Coffee Co", [{title: "Pages", links: ["Home", "Menu", "About", "Contact"]}, {title: "Company", links: ["Our Story", "Careers"]}])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_splithero_anchor, home_cardgrid_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home": "home"})
