home_navbar = Navbar(brand="Coffee Co", links=["Home", "Menu", "About", "Contact"], cta="Order Now")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_splithero = SplitHero(badge="Fresh daily", heading="We roast <hl>perfect</hl> coffee", subheading="Small-batch beans from around the world", primaryCta="Order Now", secondaryCta="Our Story")
home_splithero_anchor = SectionAnchor("home_splithero", home_splithero, "scroll-mt-28")
home_cardgrid = CardGrid(eyebrow="What we do", heading="Our craft", cards=[{title: "Espresso", description: "Double shot intensity"}, {title: "Pour Over", description: "Slow extraction"}, {title: "Cold Brew", description: "24hr steeped"}])
home_cardgrid_anchor = SectionAnchor("home_cardgrid", home_cardgrid, "scroll-mt-28")
home_footer = Footer(brand="Coffee Co", columns=[{title: "Pages", links: ["Home", "Menu", "About", "Contact"]}, {title: "Company", links: ["Our Story", "Careers"]}])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_navbar_anchor, home_splithero_anchor, home_cardgrid_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home": "home"})
