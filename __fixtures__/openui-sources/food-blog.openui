home_hero = BlogPostHero("Seasonal Spotlight", "The Ultimate Guide to Autumn Comfort Foods", "From cozy soups to hearty pies, discover recipes that celebrate the flavors of fall.", "Maria Lopez", "Photo of Maria Lopez", "June 27, 2026", "8 min read", "A rustic table set with pumpkin soup, apple crumble, and cinnamon rolls")
