about_navbar_anchor = SectionAnchor("about_navbar", about_navbar)
about_about = BlogPostAbout(["From farm‑to‑fork storytelling to practical kitchen guides, we’re the culinary compass for curious cooks."], ["Seasoned Spoon was born in a modest farmhouse kitchen in Vermont, where a group of friends turned seasonal leftovers into award‑winning recipes.","Our mission is simple: make comfort food accessible, sustainable, and deeply satisfying, while celebrating the people behind each dish."], [{"heading":"Our Story","blocks":[{"p":"Founded in 2018, we started as a weekly newsletter that highlighted hidden‑gem producers across New England. Within two years, our readership grew to 150,000 active subscribers."},{"imageAlt":"Founders gathering around a rustic kitchen table","caption":"The founders brainstorming the first “Comfort Food” series."}]},{"heading":"Credibility & Impact","blocks":[{"callout":"Over 2.3M recipes tried by our community"},{"items":["Featured in The New York Times Cooking section (2022)","Partnered with the USDA for seasonal produce guides","Awarded ‘Best Food Blog’ by the International Culinary Guild, 2023"]},{"p":"Our practical guides are vetted by a rotating panel of three professional chefs and two nutritionists, ensuring every tip is both tasty and health‑smart."}]},{"heading":"Our Team","blocks":[{"h3":"The Editorial Crew","p":"Aisha Khan – Visual Storyteller, photographer and videographer who captures the soul of every plate."}]},{"heading":"Our Process","blocks":[{"p":"Every feature article undergoes a three‑step review: recipe testing, nutritional analysis, and editorial polish. We also solicit feedback from a community panel of 50 home cooks before publishing."},{"imageAlt":"Storyboard of a recipe development workflow","caption":"From concept to kitchen: our editorial pipeline."}]}], {"quote":"Seasoned Spoon turned my kitchen into a laboratory of flavor—without the guesswork.","attribution":"Marissa Liu, longtime subscriber"}, ["Join us on this flavorful journey. Whether you’re a seasoned chef or a curious beginner, our stories, guides, and community will keep your pantry stocked with inspiration."], ["mission","team","process","impact","community"], {"name":"Emma Rivera","bio":"Lead Editor, food writer, and advocate for sustainable cooking.","avatarAlt":"Portrait of Emma Rivera smiling in a sunlit kitchen","links":["Twitter","Instagram","LinkedIn"]})
about_about_anchor = SectionAnchor("about_about", about_about, "scroll-mt-28")
