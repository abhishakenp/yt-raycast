home_about = BlogPostAbout(["Welcome to Food Blog, your go‑to source for delicious, approachable cooking content."], ["Our mission is to make home cooking joyful and accessible. Whether you’re a seasoned chef or just starting out, we provide step‑by‑step guides, seasonal round‑ups, and practical tips that empower you to create meals you’ll love."], [{"heading":"Our Story","blocks":[{"p":"Founded in 2015, Food Blog began as a humble kitchen diary. Over the years, we’ve grown into a vibrant community of food enthusiasts who share a love for flavor, culture, and creativity."}]},{"heading":"What We Offer","blocks":[{"p":"• Magazine‑style articles with stunning photography"},{"p":"• Curated collections of trending recipes"},{"p":"• In‑depth guides on techniques, ingredients, and meal planning"},{"p":"• Interactive category filters to help you find exactly what you’re looking for"}]},{"heading":"Join the Community","blocks":[{"p":"Sign up for our newsletter, follow us on social media, and become part of a community that celebrates food every day."}]}], {"quote":"Cooking is the ultimate act of love – share it generously.","attribution":"Chef Ana Ramirez"}, ["Ready to explore? Dive into our latest features, browse categories, and start cooking!"], ["food","recipes","guides","seasonal"], {"name":"Emily Chen","bio":"Editor‑in‑Chief, passionate about seasonal cooking and food storytelling.","avatarAlt":"Portrait of Emily Chen","links":["https://www.foodblog.com/about","https://www.foodblog.com/contact"]})
home_about_anchor = SectionAnchor("home_about", home_about, "scroll-mt-28")
home_footer = BlogPostFooter("Food Blog", "Taste the world at home", [{"title":"Explore","links":["Home","Recipes","Guides","Categories"]},{"title":"Company","links":["About Us","Careers","Press"]},{"title":"Support","links":["Contact","FAQ","Privacy Policy"]}], {"label":"Follow Us","href":"https://www.instagram.com/foodblog"}, ["Terms of Service","Privacy Policy"], "© 2026 Food Blog. All rights reserved.")
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
