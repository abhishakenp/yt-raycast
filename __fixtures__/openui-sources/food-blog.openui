stories_storygrid = BlogPostStoryGrid("Explore Our Latest Features", [{"category":"Comfort Cooking","date":"2024-10-02","title":"The Ultimate Guide to Autumn Comfort Foods","excerpt":"Warm up with hearty soups, roasted veggies, and spiced desserts that capture the essence of fall.","imageAlt":"Steaming bowl of pumpkin soup with cinnamon garnish"},{"category":"Seasonal Baking","date":"2024-09-28","title":"5 Cozy Apple Crumble Variations You Must Try","excerpt":"From classic crumble to caramelized walnut twists, discover recipes that make the perfect autumn dessert.","imageAlt":"Golden apple crumble fresh out of the oven"},{"category":"Meal Planning","date":"2024-09-20","title":"How to Build a Week of Comfort Meals in Under an Hour","excerpt":"A step‑by‑step guide to batch‑cook, store, and reheat dishes that keep you cozy all week long.","imageAlt":"Prepared meal containers with roasted chicken and vegetables"},{"category":"Ingredient Spotlight","date":"2024-09-15","title":"Why Sweet Potatoes Are the Hero of Autumn Cooking","excerpt":"Explore nutrition, flavor pairings, and three quick recipes that showcase sweet potatoes.","imageAlt":"Roasted sweet potato wedges drizzled with herb oil"},{"category":"Reader Favorites","date":"2024-09-10","title":"Top 10 Reader‑Chosen Comfort Recipes of 2024","excerpt":"A curated list of the most loved dishes, voted by our community of food lovers.","imageAlt":"Collage of various comfort food dishes"}])
