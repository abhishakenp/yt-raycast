home_storygrid = BlogPostStoryGrid("Trending This Week", [{"category":"Soups","date":"June 20, 2026","title":"Creamy Butternut Squash Soup with Sage","excerpt":"A velvety blend of roasted squash, aromatic sage, and a hint of nutmeg—perfect for chilly evenings.","imageAlt":"Bowl of butternut squash soup garnished with sage"},{"category":"Baking","date":"June 18,2026","title":"Apple Crumble with Oat Topping","excerpt":"Crisp apples under a buttery oat crumble, served warm with vanilla ice cream.","imageAlt":"Apple crumble fresh out of the oven"},{"category":"Drinks","date":"June 15,2026","title":"Spiced Hot Cider Cocktail","excerpt":"A festive blend of apple cider, cinnamon, and a splash of bourbon.","imageAlt":"Mug of spiced hot cider with cinnamon stick"}])
