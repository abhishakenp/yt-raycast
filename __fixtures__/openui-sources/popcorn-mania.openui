home_cta_anchor = SectionAnchor("home_cta", home_cta, "scroll-mt-28")
home_footer = ManufacturingFooter("Popcorn Mania", "#home", "About Us", "Products", ["Snack Pack","Family Pack","Party Pack"], "Where To Enjoy", ["Home","Office","Events"], "Get In Touch", "123 Popcorn Lane, Snack City, CA 90210", "(555) 123‑4567", "support@popcornmania.com", ["facebook.com/popcornmania","instagram.com/popcornmania","twitter.com/popcornmania"], ["Privacy Policy","Terms of Service"], "© 2026 Popcorn Mania")
