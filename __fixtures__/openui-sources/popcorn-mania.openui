gallery_gallery = ManufacturingGallery("Our Creations", "Taste the Crunch in Every Scene", "Explore our gallery of gourmet popcorn moments— from buttery classics to bold, artisanal blends, captured in vibrant settings that showcase the flavor and fun of Popcorn Mania.", [{"title":"Classic Butter Bliss","spec":"Golden kernels drizzled with real butter, served in a rustic wooden bowl."},{"title":"Caramel Crunch Delight","spec":"Hand‑tossed caramel popcorn with a sprinkle of sea salt, displayed on a vintage tin."},{"title":"Spicy Chili Explosion","spec":"Red‑hot chili seasoning over crisp popcorn, presented on a modern slate tray."},{"title":"Truffle & Parmesan Elegance","spec":"Fine truffle oil and shaved Parmesan on white popcorn, staged on a marble surface."},{"title":"Seasonal Pumpkin Spice","spec":"Pumpkin spice infused popcorn, perfect for fall, arranged in a pumpkin‑shaped bowl."}])
