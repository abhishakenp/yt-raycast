home_testimonials = ManufacturingTestimonials("What Our Customers Say", "Loved By Popcorn Fans", [{"quote":"The caramel popcorn is addictive – perfectly sweet and crunchy!","name":"Emma L.","role":"Home Chef","avatarAlt":"Portrait of Emma"}], [{"quote":"Great flavor variety and fast delivery.","name":"Mike D.","role":"Office Manager","avatarAlt":"Portrait of Mike"},{"quote":"Perfect for our game night – everyone loved it!","name":"Sofia R.","role":"College Student","avatarAlt":"Portrait of Sofia"}])
home_testimonials_anchor = SectionAnchor("home_testimonials", home_testimonials, "scroll-mt-28")
home_faq = ManufacturingFaq("Frequently Asked Questions", "Got Questions? We’ve Got Answers", [{"question":"Are your popcorns gluten‑free?","answer":"Yes, all our popcorns are made with gluten‑free ingredients."},{"question":"How long does shipping take?","answer":"We ship within 24 hours and most orders arrive in 2‑3 business days."},{"question":"Do you offer vegan options?","answer":"Absolutely – our caramel and classic butter flavors are vegan‑friendly."}])
home_faq_anchor = SectionAnchor("home_faq", home_faq, "scroll-mt-28")
