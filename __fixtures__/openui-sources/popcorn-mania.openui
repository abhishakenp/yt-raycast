pricing_navbar = ManufacturingNavbar("Popcorn Mania", ["Home","Pricing","Gallery"])
pricing_navbar_anchor = SectionAnchor("pricing_navbar", pricing_navbar)
pricing_pricing = ManufacturingPricing("Choose Your Crunch", "Flexible Plans for Every Business", "Select the perfect popcorn package to delight your customers and boost sales. All plans include fresh, gourmet kernels, premium seasonings, and reliable delivery.", [{"name":"Starter Popcorn Pack","blurb":"Ideal for boutique cafés and small events.","price":"$49","unit":"/month","features":["Up to 200 lbs of assorted flavors","Standard packaging","Monthly delivery","Basic support"],"cta":"Start Small"},{"name":"Growth Popcorn Pack","blurb":"Scale up with more variety and branding options.","price":"$119","unit":"/month","features":["Up to 500 lbs of assorted flavors","Custom branded packaging","Bi‑weekly delivery","Priority support","Free seasonal flavor sampler"],"cta":"Grow Your Crunch","featured":true,"badge":"Most Popular"},{"name":"Enterprise Popcorn Pack","blurb":"Full‑service solution for national chains and large venues.","price":"$299","unit":"/month","features":["Unlimited flavors","Fully custom packaging and co‑branding","Weekly delivery","Dedicated account manager","On‑site pop‑up support","Marketing collateral bundle"],"cta":"Go Enterprise"}])
pricing_pricing_anchor = SectionAnchor("pricing_pricing", pricing_pricing, "scroll-mt-28")
pricing_faq = ManufacturingFaq("Got Questions?", "Everything You Need to Know", [{"question":"What’s included in each delivery?","answer":"Each shipment contains the full weight of popcorn listed in your tier, assorted gourmet flavors, and any custom packaging you’ve selected. We also include a recipe card with serving ideas."},{"question":"Can I change my plan after signing up?","answer":"Absolutely. You can upgrade, downgrade, or pause your subscription at any time from your account dashboard with no penalty."},{"question":"Do you offer a satisfaction guarantee?","answer":"Yes. If your first delivery doesn’t meet our quality standards, we’ll replace it free of charge or issue a full refund—your choice."},{"question":"How do you ensure freshness?","answer":"Our popcorn is roasted and seasoned on the same day it ships, then packed in airtight bags to lock in flavor until it reaches your door."}])
pricing_faq_anchor = SectionAnchor("pricing_faq", pricing_faq, "scroll-mt-28")
pricing_cta = ManufacturingCta("Ready to Elevate Your Snack Game?", "Join the growing list of businesses serving premium popcorn that keeps customers coming back for more.", "Select a Plan", "Contact Sales", "No credit card required to start a free 7‑day trial of any plan.")
