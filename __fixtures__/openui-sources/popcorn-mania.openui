gallery_testimonials = ManufacturingTestimonials("What Our Fans Say", "Popcorn Moments Loved Worldwide", [{"quote":"The caramel popcorn arrived fresh and perfectly crunchy—my kids couldn't stop eating it!","name":"Jenna L.","role":"Mom & Food Blogger","avatarAlt":"Portrait of Jenna, smiling"},{"quote":"We ordered the truffle & parmesan for our office party and it was the star of the snack table.","name":"Mark D.","role":"Startup Founder","avatarAlt":"Headshot of Mark, wearing a blazer"}], [{"quote":"Fast delivery and unbeatable flavor.","name":"Sofia R.","role":"College Student","avatarAlt":"Sofia smiling"},{"quote":"The spicy chili blend is my new favorite movie snack.","name":"Liam K.","role":"Film Critic","avatarAlt":"Liam with glasses"},{"quote":"Perfect for holiday gatherings—everyone loved the pumpkin spice.","name":"Aisha M.","role":"Event Planner","avatarAlt":"Aisha in a festive setting"}])
