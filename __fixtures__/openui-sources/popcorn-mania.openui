home_gallery = ManufacturingGallery("Our Flavors", "Explore the Variety", "From sweet to savory, we have a popcorn for every craving.", [{"title":"Caramel Delight","spec":"Sweet caramel coating with a hint of sea salt"},{"title":"Cheddar Burst","spec":"Sharp cheddar cheese dusted popcorn"},{"title":"Spicy Chili","spec":"Heat‑infused chili flakes for a bold kick"},{"title":"Classic Butter","spec":"Traditional buttery goodness"}])
home_gallery_anchor = SectionAnchor("home_gallery", home_gallery, "scroll-mt-28")
home_industries = ManufacturingIndustries("Perfect For", "Enjoy Popcorn Anywhere", "Whether at home, office, or events, our popcorn fits every setting.", [{"title":"Home Snacking","description":"Movie nights and family gatherings","tag":"Home"},{"title":"Corporate Events","description":"Snack breaks and client gifts","tag":"Business"},{"title":"Sports Venues","description":"Stadiums and fan zones","tag":"Sports"}])
home_industries_anchor = SectionAnchor("home_industries", home_industries, "scroll-mt-28")
home_pricing = ManufacturingPricing("Pricing Plans", "Choose Your Popcorn Pack", "Flexible bundles for every appetite.", [{"name":"Snack Pack","blurb":"Perfect for one or two people","price":"$12.99","unit":"per bag","features":["1 Large Bag","Classic Flavors","Free Shipping"],"cta":"Buy Now","featured":false},{"name":"Family Pack","blurb":"Great for families and gatherings","price":"$34.99","unit":"per pack","features":["3 Large Bags","Mix of Flavors","Free Shipping"],"cta":"Buy Now","featured":true,"badge":"Best Value"},{"name":"Party Pack","blurb":"Ideal for events and parties","price":"$59.99","unit":"per pack","features":["6 Large Bags","Assorted Flavors","Priority Shipping"],"cta":"Buy Now","featured":false}])
