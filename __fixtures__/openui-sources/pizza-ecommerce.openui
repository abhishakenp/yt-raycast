home_navbar = EcommerceNavbar("Cheese Filed", ["Home","Gallery"], "/", "Shop Now", "/shop", "0")
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_hero = EcommerceHero("Freshly Baked", "Cheese‑Filled Pizza Perfection", "Hand‑crafted crusts loaded with melty mozzarella, cheddar, and gouda. Delivered hot, straight to your door.", "Order Yours", "View Menu", "Triple‑Cheese Supreme", "$14.99", "12″ pizza, extra cheese", "Add to Cart", "Triple‑Cheese Supreme pizza on wooden board", "Best Seller", ["Free Delivery","30‑Day Guarantee","Organic Ingredients"])
home_hero_anchor = SectionAnchor("home_hero", home_hero, "scroll-mt-28")
home_features = EcommerceFeatures("Why Choose Cheese Filed?", "Because every bite should be a celebration of cheese.", [{"title":"Premium Cheeses","description":"Only the finest mozzarella, cheddar, provolone, and gouda make it into our pies."},{"title":"Hand‑Tossed Crust","description":"Our dough is fermented for 48 hours for a light, airy texture."},{"title":"Fast Delivery","description":"Order online and get your pizza in under 30 minutes, hot and fresh."}])
home_features_anchor = SectionAnchor("home_features", home_features, "scroll-mt-28")
home_gallery = EcommerceGallery("Explore Our Menu", "Curated collections for every cheese lover", "Add to Cart", [{"name":"Margherita Mozzarella","price":"$12.99","oldPrice":"$14.99","badge":"20% Off","imageAlt":"Margherita Mozzarella pizza slice"},{"name":"Four‑Cheese Blast","price":"$15.99","badge":"New","imageAlt":"Four‑Cheese Blast pizza whole"},{"name":"Cheesy Garlic Bread","price":"$6.99","imageAlt":"Cheesy Garlic Bread side view"},{"name":"Cheese‑Stuffed Calzones","price":"$13.49","imageAlt":"Cheese‑Stuffed Calzone cut open"}])
home_gallery_anchor = SectionAnchor("home_gallery", home_gallery, "scroll-mt-28")
home_overview = EcommerceOverview("Cheese Filed", "Premium Storefront", "From Our Oven to Your Doorstep", "Explore curated bundles, seasonal specials, and exclusive deals designed for cheese enthusiasts.", "Shop Bundles", "Learn More", "Assortment of cheese‑filled pizzas on a rustic table", ["Curated Collections","Best‑Seller Highlights","Easy Checkout"], [{"value":"5K+","label":"Happy Customers"},{"value":"120","label":"Daily Orders"},{"value":"99%","label":"Satisfaction Rate"}])
home_overview_anchor = SectionAnchor("home_overview", home_overview, "scroll-mt-28")
home_testimonials = EcommerceTestimonials("What Our Fans Say", "Cheese lovers across the country rave about us", [{"quote":"The cheese pull is unreal—every slice is a stretch of pure joy!","name":"Lena M.","rating":5,"avatarAlt":"Portrait of Lena"},{"quote":"Fast delivery and the crust is perfectly crisp. My family can’t get enough.","name":"Carlos R.","rating":4,"avatarAlt":"Portrait of Carlos"},{"quote":"Best pizza night ever. The triple‑cheese combo is my go‑to.","name":"Aisha K.","rating":5,"avatarAlt":"Portrait of Aisha"}])
home_testimonials_anchor = SectionAnchor("home_testimonials", home_testimonials, "scroll-mt-28")
home_cta = EcommerceCta("Got Questions?", "We’re here to help you pick the perfect pizza", "Send Message", "Your email or phone", "We never share your info. Unsubscribe anytime.")
home_cta_anchor = SectionAnchor("home_cta", home_cta, "scroll-mt-28")
home_footer = EcommerceFooter("Cheese Filed", "Cheese. Pizza. Happiness.", [{"title":"Shop","links":["Menu","Bundles","Gift Cards"]},{"title":"Company","links":["About Us","Careers","Press"]},{"title":"Help","links":["FAQ","Contact","Track Order"]}], [{"label":"Instagram","href":"https://instagram.com/cheesefiled"},{"label":"Facebook","href":"https://facebook.com/cheesefiled"},{"label":"Twitter","href":"https://twitter.com/cheesefiled"}], "© 2026 Cheese Filed. All rights reserved.")
