home_navbar = BlogNavbar("Dog Blog", ["Home","Explore"], "/", "Subscribe", "/subscribe")
home_hero = BlogHero("Happy golden retriever playing in a park", "Dog Care", "Featured", "How to Keep Your Dog Happy and Healthy", "Discover proven tips for nutrition, exercise, and mental stimulation that will keep your canine companion thriving.", "Jane Barker", "5 min read", "June 20, 2026", "Read article", "/posts/happy-healthy-dog")
home_storygrid = BlogStoryGrid("Latest Stories", "View All Posts", "/posts", "/posts", [{"tag":"Nutrition","title":"The Best Homemade Dog Food Recipes","excerpt":"Simple, balanced meals you can make at home for a healthier pup.","author":"Mike Torres","date":"June 18, 2026","alt":"Bowl of homemade dog food"},{"tag":"Training","title":"Positive Reinforcement Techniques","excerpt":"How to train your dog using kindness and rewards.","author":"Laura Chen","date":"June 15,2026","alt":"Dog receiving a treat"},{"tag":"Health","title":"Spotting Early Signs of Joint Issues","excerpt":"What to look for and when to see a vet.","author":"Dr. Sam Patel","date":"June 12,2026","alt":"Dog with a bandaged paw"}])
home_topics = BlogTopics("Explore Dog Topics", "From puppy basics to senior care, find articles that match your dog’s life stage.", [{"title":"Puppy Training","description":"Essential commands and socialization tips for new pups."},{"title":"Senior Dog Health","description":"Managing arthritis, diet, and comfort for older dogs."},{"title":"Breed Spotlights","description":"Deep dives into temperament and care for popular breeds."},{"title":"Travel with Dogs","description":"Road trip prep, pet-friendly hotels, and safety gear."}], 4)
home_authors = BlogAuthors("Meet Our Experts", "Our Dog Lovers", "Passionate writers and veterinarians sharing trusted advice.", [{"name":"Jane Barker","role":"Senior Editor","bio":"Dog enthusiast with 10 years of experience writing about canine wellness.","avatarAlt":"Portrait of Jane Barker"},{"name":"Mike Torres","role":"Nutrition Specialist","bio":"Certified pet nutritionist who loves cooking up healthy meals for dogs.","avatarAlt":"Portrait of Mike Torres"},{"name":"Laura Chen","role":"Training Coach","bio":"Positive‑reinforcement trainer helping owners build strong bonds with their dogs.","avatarAlt":"Portrait of Laura Chen"},{"name":"Dr. Sam Patel","role":"Veterinarian","bio":"Board‑certified vet focusing on preventative care and senior dog health.","avatarAlt":"Portrait of Dr. Sam Patel"}])
home_footer = BlogFooter("Dog Blog", "Your daily dose of dog love", [{"label":"Facebook","href":"https://facebook.com/dogblog"},{"label":"Instagram","href":"https://instagram.com/dogblog"},{"label":"Twitter","href":"https://twitter.com/dogblog"}], [{"title":"Explore","links":["Home","All Posts","Topics","Authors"]},{"title":"Resources","links":["Nutrition Guides","Training Tips","Health FAQs"]},{"title":"Legal","links":["Privacy Policy","Terms of Service"]}], "© 2026 Dog Blog. All rights reserved.")
home = Stack([home_navbar, home_hero, home_storygrid, home_topics, home_authors, home_footer])
explore_navbar = BlogNavbar("Dog Blog", ["Home","Explore"], "/", "Join the Pack", "/signup")
explore_hero = BlogHero("Golden retriever puppy playing in a meadow", "Dog Training", "Featured", "5 Proven Ways to Teach Your Dog New Tricks", "Discover step‑by‑step techniques that turn even the most stubborn pup into a quick learner. From clicker training to positive reinforcement, we’ve got you covered.", "Mia Hernandez", "8 min", "2026-05-14", "Read Article", "/posts/5-proven-ways-teach-dog-tricks")
explore_storygrid = BlogStoryGrid("Latest Dog Adventures", "See All Stories", "/stories", "/posts", [{"tag":"Rescue","title":"From Shelter to Star: Luna’s Journey","excerpt":"Luna was rescued from a busy city shelter and now stars in a local therapy dog program. Read her heart‑warming transformation.","author":"Jared Kim","date":"2026-04-28","alt":"Luna the labradoodle wearing a bandana"},{"tag":"Training","title":"How We Mastered Off‑Leash Recall","excerpt":"A step‑by‑step guide that helped our Border Collie answer every call, even at the park’s busiest hour.","author":"Sofia Patel","date":"2026-04-22","alt":"Border collie sprinting towards owner in a park"},{"tag":"Health","title":"Seasonal Allergies in Dogs: What to Watch For","excerpt":"Spring brings blossoms—and sneezes. Learn the signs of allergies and how to keep your canine comfortable.","author":"Dr. Luis Ortega","date":"2026-04-15","alt":"Dog with a tissue near a flower bed"}])
explore_topics = BlogTopics("Explore Our Dog‑Centric Topics", "From training tricks to health tips, we cover every wagging need.", [{"title":"Training Techniques","description":"Positive reinforcement, agility drills, and obedience tips for dogs of all ages."},{"title":"Nutrition & Wellness","description":"Balanced diets, supplement guides, and recipes for homemade treats."},{"title":"Behavior & Psychology","description":"Understanding canine body language, anxiety solutions, and socialization."},{"title":"Adventure & Travel","description":"Pet‑friendly road trips, hiking gear, and safety tips for exploring the great outdoors."}], 3)
explore_authors = BlogAuthors("Meet the Pack", "Our Expert Contributors", "Passionate dog lovers sharing knowledge, stories, and advice.", [{"name":"Mia Hernandez","role":"Senior Trainer","bio":"Certified clicker trainer with 10 years of experience working with rescue dogs and service animals.","avatarAlt":"Portrait of Mia Hernandez smiling with a golden retriever"},{"name":"Dr. Luis Ortega","role":"Veterinary Consultant","bio":"Board‑certified veterinarian specializing in canine dermatology and nutrition.","avatarAlt":"Dr. Luis Ortega in a clinic coat holding a stethoscope"},{"name":"Sofia Patel","role":"Community Manager","bio":"Dog park enthusiast who curates our weekly Q&A sessions and community events.","avatarAlt":"Sofia Patel laughing with a group of dogs at a park"}])
explore_footer = BlogFooter("Dog Blog", "Every dog has a story. Let’s write yours together.", [{"label":"Instagram","href":"https://instagram.com/pawsandtales"},{"label":"Facebook","href":"https://facebook.com/pawsandtales"},{"label":"Twitter","href":"https://twitter.com/pawsandtales"},{"label":"YouTube","href":"https://youtube.com/c/pawsandtales"}], [{"title":"Explore","links":["Home","Stories","Training","Health","Community"]},{"title":"Resources","links":["Blog","FAQs","Contact","Privacy Policy","Terms of Service"]},{"title":"Connect","links":["Newsletter","Events","Volunteer","Donate"]}], "© 2026 Paws & Tales. All rights reserved.")
explore = Stack([explore_navbar, explore_hero, explore_storygrid, explore_topics, explore_authors, explore_footer])
root = PageSwitch(["Home","Explore"], [home, explore])