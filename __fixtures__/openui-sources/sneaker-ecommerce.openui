about_testimonials = FashionStoreTestimonials("What Our Community Says", "Real Voices from the Streets", [{"quote":"Pulse Kicks gave me the confidence to own every step. The drops are always fresh and the fit is unmatched.","name":"Mia Torres","role":"Streetwear Influencer","avatarAlt":"Portrait of Mia Torres"},{"quote":"I love the limited drops—once they’re gone, they’re gone. The quality feels premium, and the designs turn heads.","name":"Jamal Reed","role":"Sneaker Collector","avatarAlt":"Portrait of Jamal Reed"},{"quote":"The size selector and zoom features make shopping online feel like a personal boutique experience.","name":"Lena Wu","role":"Fashion Blogger","avatarAlt":"Portrait of Lena Wu"}])
