home_hero = EcommerceHero("Boutique Coffee Roastery", "Crafted for YOU", "Subscribe for fresh beans delivered to your door", null, null, null, null, null, null, "roastery interior view")
home_hero_anchor = SectionAnchor("home_hero", home_hero, "scroll-mt-28")
home_features = EcommerceFeatures("Our Offerings", "Explore the world of coffee", [{"title":"Monthly Subscription","description":"Receive curated beans each month"},{"title":"Fresh Roast","description":"Beans roasted within 24h of order"},{"title":"Tasting Events","description":"Join guided coffee tasting sessions with our master roasters"}])
home_features_anchor = SectionAnchor("home_features", home_features, "scroll-mt-28")
home_gallery = EcommerceGallery("Our Coffees", "Hand‑selected blends for every palate", null, [{"name":"Ethiopian Yirgacheffe","price":"18","oldPrice":"16","badge":"Best Seller","imageAlt":"bag of beans"},{"name":"Colombian Supremo","price":"20","oldPrice":"","badge":"New Arrival","imageAlt":"Colombian beans"},{"name":"Sumatra Mandheling","price":"22","oldPrice":"","badge":"Limited Edition","imageAlt":"Sumatra beans"}])
home_gallery_anchor = SectionAnchor("home_gallery", home_gallery, "scroll-mt-28")
home_testimonials = EcommerceTestimonials("What Our Customers Say", "Stories from coffee lovers", [{"quote":"“The subscription changed my mornings!”","name":"Laura M.","role":"Coffee Enthusiast","rating":"5"},{"quote":"“Tasting events are pure joy.”","name":"Mark D.","role":"Barista","rating":"5"}])
home_testimonials_anchor = SectionAnchor("home_testimonials", home_testimonials, "scroll-mt-28")
home_cta = EcommerceCta("Join the Roast", "Start your subscription today")
home_cta_anchor = SectionAnchor("home_cta", home_cta, "scroll-mt-28")
home_logos = EcommerceLogos("Our Partners", [{"label":"Starbucks"}])
home_logos_anchor = SectionAnchor("home_logos", home_logos, "scroll-mt-28")
home_navbar = EcommerceNavbar("Boutique Coffee Roastery", ["Home"])
home_navbar_anchor = SectionAnchor("home_navbar", home_navbar)
home_footer = EcommerceFooter("Boutique Coffee Roastery", "tagline", [{"title":"About","links":["Our Story","Sustainability","Contact","Help","FAQ"]}], ["Instagram","Twitter","Facebook"])
home_footer_anchor = SectionAnchor("home_footer", home_footer, "scroll-mt-28")
home = Stack([home_hero_anchor, home_features_anchor, home_gallery_anchor, home_testimonials_anchor, home_cta_anchor, home_logos_anchor, home_navbar_anchor, home_footer_anchor])
root = PageSwitch(["Home"], [home], "", {"Home":"home"})