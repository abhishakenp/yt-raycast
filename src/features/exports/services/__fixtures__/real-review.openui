home_products = ProductGrid({"heading":"Our Coffees","products":[{"name":"Ethiopian Yirgacheffe","price":"18","imageAlt":"bag of beans"},{"name":"Colombian Supremo","price":"20","imageAlt":"Colombian beans"},{"name":"Sumatra Mandheling","price":"22","imageAlt":"Sumatra beans"}]})
