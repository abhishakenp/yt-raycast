{
  "name": "ship-fast",
  "version": "1.0.0",
  "packageManager": "bun@1.2.5",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ship-fast": "src/index.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "verify:site-spec": "node scripts/vemrify-site-spec.js",
    "verify:swiper-policy": "node scripts/verify-swiper-policy.mjs",
    "studio:build": "cd studio && bun --env-file=../.env.local --env-file=../.env run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@portabletext/to-html": "^5.0.2",
    "@sanity/client": "^7.20.0",
    "express": "^4.21.0",
    "firebase-admin": "^13.7.0",
    "multer": "^2.1.1",
    "open": "^10.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
