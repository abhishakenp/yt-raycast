{
  "name": "ship-fast",
  "version": "1.0.0",
  "packageManager": "bun@1.2.5",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev:next": "next dev --turbopack",
    "dev": "bash -c 'for p in 7420 3000; do kill $(lsof -t -i:$p) 2>/dev/null || true; done; sleep 0.3; bun run dev:backend & BP=$!; trap \"kill $BP 2>/dev/null\" INT TERM EXIT; sleep 2; exec bun run dev:next'",
    "dev:backend": "NODE_ENV=development bun --watch src/index.js",
    "dev:stack": "bun run dev",
    "build": "next build",
    "start": "sh deploy/start.sh",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "verify:site-spec": "node scripts/verify-site-spec.js",
    "sync:medusa-catalog": "node scripts/sync-ecommerce-to-medusa.js",
    "medusa:up": "docker compose -f infra/medusa/docker-compose.yml up -d postgres redis",
    "medusa:wait-db": "sh scripts/wait-medusa-postgres.sh",
    "medusa:bootstrap-db": "docker compose -f infra/medusa/docker-compose.yml up -d postgres redis && sh scripts/wait-medusa-postgres.sh && bun run medusa:migrate && bun run medusa:seed",
    "medusa:docker": "docker compose -f infra/medusa/docker-compose.yml up --build -d",
    "medusa:docker:down": "docker compose -f infra/medusa/docker-compose.yml down",
    "medusa:migrate": "cd medusa-backend && bun run db:migrate",
    "medusa:seed": "cd medusa-backend && bun run seed",
    "medusa:delete-demo-products": "cd medusa-backend && bun run delete-demo-products",
    "medusa:dev": "cd medusa-backend && bun run dev",
    "medusa:user": "cd medusa-backend && bun run user:create",
    "medusa:migrate:docker": "docker compose -f infra/medusa/docker-compose.yml run --rm medusa-migrate",
    "medusa:seed:docker": "docker compose -f infra/medusa/docker-compose.yml run --rm medusa-migrate node ./node_modules/@medusajs/cli/cli.js exec ./src/scripts/seed.ts",
    "aurora:qa": "node scripts/aurora-quality-loop.js",
    "ralph:design": "node scripts/browser-design-ralph.mjs",
    "ralph:nova": "RALPH_ONLY=design-03-saas RALPH_MAX_ROUNDS=6 node scripts/browser-design-ralph.mjs",
    "verify:homepage": "node scripts/homepage-quality-gate.mjs",
    "verify:swiper-policy": "node scripts/verify-swiper-policy.mjs",
    "benchmark:groq-homepage-models": "bun scripts/groq-homepage-model-benchmark.js",
    "studio:build": "cd studio && bun --env-file=../.env.local --env-file=../.env run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@medusajs/js-sdk": "^2.13.5",
    "@portabletext/to-html": "^5.0.2",
    "@sanity/client": "^7.21.0",
    "@tanstack/react-query": "^5.99.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.7.0",
    "franc-min": "^6.2.0",
    "http-proxy": "^1.18.1",
    "multer": "^2.1.1",
    "next": "15.2.4",
    "open": "^10.1.0",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "globals": "^15.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
