{
  "name": "ship-fast",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.5",
  "engines": {
    "node": "22.x",
    "bun": "1.2.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:react-export-sources": "node packages/ship-fast-blocks/scripts/generate-react-export-sources.mjs",
    "generate-routes": "tsr generate",
    "prebuild": "bun run generate:react-export-sources",
    "verify:generation": "node scripts/verify-generation-agent-browser.mjs",
    "verify:site-spec": "node scripts/verify-site-spec.mjs",
    "verify:homepage-quality": "node scripts/homepage-quality-gate.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "verify:admission": "node scripts/verify-admission.mjs",
    "verify:authenticated-admission": "bun run test -- convex/authenticated-admission.test.ts",
    "verify:restored-routes": "node scripts/verify-restored-routes.mjs",
    "verify:deployment-preview": "node scripts/verify-deployment-preview.mjs",
    "verify:seo-aeo": "node scripts/verify-seo-aeo.mjs",
    "verify:brand-localization": "node scripts/verify-brand-localization.mjs",
    "verify:billing": "node scripts/verify-billing.mjs",
    "verify:billing-state": "bun run test -- convex/billing.test.ts",
    "verify:github-provider": "node scripts/verify-github-provider.mjs",
    "verify:medusa": "node scripts/verify-medusa.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "verify:chat-refinement": "node scripts/verify-chat-refinement.mjs",
    "verify:dashboard-browser": "node scripts/verify-dashboard-browser.mjs",
    "verify:chat-browser": "node scripts/verify-chat-browser.mjs",
    "verify:cms-browser": "node scripts/verify-cms-browser.mjs",
    "verify:monitoring": "node scripts/verify-monitoring.mjs",
    "verify:restart-persistence": "node scripts/verify-restart-persistence.mjs",
    "verify:change-groups": "bun scripts/verify-change-groups.ts",
    "verify:change-report": "bun scripts/verify-change-groups.ts --check-report",
    "verify:review-readiness": "bun scripts/verify-review-readiness.ts",
    "verify:quality-exit": "bun scripts/verify-quality-exit.ts",
    "review:groups": "bun scripts/export-review-groups.ts",
    "verify:generated": "node packages/ship-fast-blocks/scripts/generate-react-export-sources.mjs --check",
    "verify:capsule-sources": "bun scripts/verify-capsule-source-classification.ts",
    "verify:bundle": "bun scripts/verify-build-bundles.ts",
    "verify:precommit": "node scripts/git-hook-quality-gate.mjs pre-commit",
    "verify:prepush": "node scripts/git-hook-quality-gate.mjs pre-push",
    "verify:qa": "bun run lint && bun run typecheck && bun run test:coverage && bun run verify:change-groups && bun run verify:review-readiness && bun run verify:generated && bun run verify:capsule-sources && bun run build && bun run verify:bundle",
    "verify:release": "bun run verify:qa && bun run verify:providers",
    "prepare": "node scripts/git-hook-quality-gate.mjs install",
    "build": "vite build",
    "deploy:convex": "bun scripts/deploy-convex.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"convex/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" --no-error-on-unmatched-pattern --max-warnings=0",
    "format": "prettier --write . && bun run lint --fix",
    "check": "prettier --check .",
    "reset:deps": "rm -rf node_modules bun.lock && bun install",
    "format:packagejson": "bunx prettier-package-json --write ./package.json",
    "clean-all-node-modules": "bunx npkill",
    "ncu-u": "ncu -u --deep",
    "release-all-ports": "killall node"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@clerk/tanstack-react-start": "^1.3.3",
    "@clerk/ui": "^1.15.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@iconify/react": "^6.0.2",
    "@legendapp/state": "3.0.0-beta.47",
    "@openuidev/lang-core": "^0.2.5",
    "@openuidev/react-headless": "^0.8.2",
    "@openuidev/react-lang": "^0.2.6",
    "@openuidev/react-ui": "^0.11.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.28.6",
    "@ship-fast/aeo": "workspace:*",
    "@ship-fast/blocks": "workspace:*",
    "@ship-fast/engine": "workspace:*",
    "@ship-fast/lakebed": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.0",
    "@xyflow/react": "^12.10.2",
    "agentation": "^3.0.2",
    "ai": "^6.0.193",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.41.0",
    "crossws": "^0.4.6",
    "date-fns": "^4.3.0",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "franc-min": "^6.2.0",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.2.5",
    "input-otp": "^1.4.2",
    "lakebed": "0.0.25",
    "little-date": "^1.2.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.577.0",
    "media-chrome": "^4.19.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@latest",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.78.0",
    "react-icons": "^5.6.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4",
    "react-table": "^7.8.0",
    "react-use": "17.6.0",
    "react-virtualized-auto-sizer": "1.0.26",
    "react-window": "1.8.11",
    "recharts": "3.8.0",
    "simplebar-react": "^3.3.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.184.0",
    "tw-animate-css": "^1.3.6",
    "use-stick-to-bottom": "^1.1.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-table": "^7.7.2",
    "@types/react-window": "^1.8.5",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.8",
    "convex-test": "^0.0.53",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
