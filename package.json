{
  "name": "ship-fast-vanilla",
  "version": "1.0.0",
  "packageManager": "bun@1.2.5",
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "axios": "1.17.0",
    "brace-expansion": "5.0.6",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.8.0",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "0.1.13",
    "prismjs": "1.30.0",
    "protobufjs": "8.6.0",
    "uuid": "14.0.0",
    "ws": "8.21.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "src/index.js",
  "scripts": {
    "dev": "bash -c 'kill $(lsof -t -i:7420) 2>/dev/null || true; sleep 0.3; bun run build:scripts; NODE_ENV=development DASHBOARD_PORT=7420 bun --watch src/index.js'",
    "dev:no-watch": "NODE_ENV=development DASHBOARD_PORT=7420 bun src/index.js",
    "start": "DASHBOARD_PORT=7420 node src/index.js",
    "build:scripts": "bun run scripts/build-browser-scripts.ts",
    "build": "bun run build:scripts",
    "start:shell:dev": "vite dev --host 127.0.0.1 --port 7430",
    "start:shell:build": "vite build",
    "start:shell:preview": "vite preview --host 127.0.0.1 --port 7431",
    "verify:generation": "node scripts/verify-generation-agent-browser.mjs",
    "test:agentation": "vitest run src/agentation/agentation-session.test.js src/session-domain/agentation-annotations.test.js",
    "test:start-shell": "vitest run src/start/create-session-request.test.js",
    "test:session-domain": "vitest run src/session-domain/filesystem-session-repository.test.js src/session-domain/session-api-response.test.js src/session-domain/generated-preview-html.test.js src/session-domain/preview-text-edits.test.js src/session-domain/ai-text-rewrite.test.js src/session-domain/session-exports.test.js src/session-domain/session-deployments.test.js src/session-domain/session-github.test.js src/session-domain/session-cms.test.js",
    "test:server-services": "vitest run src/server/session-deployments.test.js",
    "studio:install": "cd studio && bun install --no-frozen-lockfile",
    "studio:build": "cd studio && bun run studio:build",
    "studio:dev": "cd studio && bun run dev",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "verify:site-spec": "node scripts/verify-site-spec.js",
    "sync:medusa-catalog": "node scripts/sync-ecommerce-to-medusa.js",
    "verify:swiper-policy": "node scripts/verify-swiper-policy.mjs",
    "medusa:up": "docker compose -f infra/medusa/docker-compose.yml up -d postgres redis",
    "medusa:down": "docker compose -f infra/medusa/docker-compose.yml down",
    "medusa:logs": "docker compose -f infra/medusa/docker-compose.yml logs -f --tail=200",
    "medusa:nuke": "docker compose -f infra/medusa/docker-compose.yml down -v && rm -f infra/medusa/sessions/docker-compose.session-*.yml",
    "medusa:sessions": "ls -1 infra/medusa/sessions/docker-compose.session-*.yml 2>/dev/null | wc -l | awk '{print $1\" tenant compose file(s)\"}' && docker ps --filter \"name=medusa-session-\" --format \"table {{.Names}}\\t{{.Ports}}\\t{{.Status}}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@clerk/backend": "3.5.0",
    "@clerk/clerk-js": "^6.14.0",
    "@clerk/clerk-react": "5.61.3",
    "@medusajs/js-sdk": "^2.15.5",
    "@openuidev/lang-core": "^0.2.5",
    "@openuidev/react-lang": "^0.2.6",
    "@portabletext/to-html": "^5.0.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "agentation": "^3.0.2",
    "cmdk": "^1.1.1",
    "@sanity/client": "^7.21.0",
    "@ship-fast/aeo": "workspace:*",
    "@ship-fast/blocks": "workspace:*",
    "@ship-fast/engine": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "@tanstack/router-plugin": "^1.168.18",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "franc-min": "^6.2.0",
    "http-proxy": "^1.18.1",
    "idb-keyval": "^6.2.5",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.11.0",
    "multer": "^2.1.1",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.5"
  }
}
