"use client";

import { useState } from "react";
import { use{{ENTITY}}s, useDelete{{ENTITY}} } from "@/hooks/use{{ENTITY}}s";
import type { {{ENTITY}} } from "@/hooks/use{{ENTITY}}s";
import type { Id } from "@/convex/_generated/dataModel";

interface {{ENTITY}}ListProps {
  onEdit?: (item: {{ENTITY}}) => void;
}

export const {{ENTITY}}List = ({ onEdit }: {{ENTITY}}ListProps) => {
  const { data: {{entity}}s, isLoading, error } = use{{ENTITY}}s();
  const deleteMutation = useDelete{{ENTITY}}();
  const [deletingId, setDeletingId] = useState<Id<"{{entities}}"> | null>(null);

  const handleDelete = async (id: Id<"{{entities}}">) => {
    setDeletingId(id);
    try {
      await deleteMutation.mutateAsync({ id });
    } finally {
      setDeletingId(null);
    }
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center py-12">
        <div className="h-6 w-6 animate-spin rounded-full border-2 border-primary border-t-transparent" />
      </div>
    );
  }

  if (error) {
    return (
      <div className="rounded-lg border border-destructive/20 bg-destructive/5 p-4 text-sm text-destructive">
        Failed to load: {error.message}
      </div>
    );
  }

  if (!{{entity}}s?.length) {
    return (
      <div className="py-12 text-center text-sm text-muted-foreground">
        No {{entity}}s yet.
      </div>
    );
  }

  return (
    <div className="overflow-hidden rounded-lg border">
      <table className="w-full text-sm">
        <thead>
          <tr className="border-b bg-muted/50">
            {{TABLE_HEADERS}}
            <th className="px-4 py-3 text-right font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{{entity}}s.map((item) => (
            <tr key={item._id} className="border-b last:border-0 hover:bg-muted/30">
              {{TABLE_CELLS}}
              <td className="px-4 py-3 text-right">
                <div className="flex items-center justify-end gap-2">
                  {onEdit && (
                    <button
                      onClick={() => onEdit(item)}
                      className="rounded px-2 py-1 text-xs font-medium text-primary hover:bg-primary/10"
                    >
                      Edit
                    </button>
                  )}
                  <button
                    onClick={() => handleDelete(item._id)}
                    disabled={deletingId === item._id}
                    className="rounded px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 disabled:opacity-50"
                  >
                    {deletingId === item._id ? "..." : "Delete"}
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

