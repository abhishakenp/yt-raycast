// Replace {{ENTITY}}, {{entity}}, {{SCHEMA_FIELDS}}, {{DEFAULT_VALUES}}

"use client";

import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { useCreate{{ENTITY}}, useUpdate{{ENTITY}} } from "./use{{ENTITY}}s";
import type { {{ENTITY}} } from "./use{{ENTITY}}s";

export const {{entity}}Schema = z.object({
  {{SCHEMA_FIELDS}}
});

export type {{ENTITY}}FormValues = z.infer<typeof {{entity}}Schema>;

export const use{{ENTITY}}Form = (existing?: {{ENTITY}} | null) => {
  const createMutation = useCreate{{ENTITY}}();
  const updateMutation = useUpdate{{ENTITY}}();

  const form = useForm<{{ENTITY}}FormValues>({
    resolver: zodResolver({{entity}}Schema),
    defaultValues: existing
      ? {
          {{EXISTING_TO_FORM}}
        }
      : {
          {{DEFAULT_VALUES}}
        },
  });

  const onSubmit = form.handleSubmit(async (data) => {
    if (existing) {
      await updateMutation.mutateAsync({ id: existing._id, ...data });
    } else {
      await createMutation.mutateAsync(data);
    }
    form.reset();
  });

  const isSubmitting = createMutation.isPending || updateMutation.isPending;

  return { form, onSubmit, isSubmitting };
};
