        "bodyHtml": "<div class=\"site-shell\">\n      \n        \n        <header class=\"site-header\" data-mobile-nav>\n          <div class=\"container nav-shell\">\n            <a class=\"brand\" href=\"/\"><span class=\"brand-logo\" aria-hidden=\"false\" style=\"height:44px\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 160 48\" role=\"img\" aria-label=\"Marrow — a nose-to-tail butchery and supper club in Lisbon logo\"><rect x=\"0\" y=\"0\" width=\"160\" height=\"48\" rx=\"14\" fill=\"hsl(26 78% 46%)\"/><text x=\"80\" y=\"31\" text-anchor=\"middle\" font-family=\"Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif\" font-size=\"20\" font-weight=\"800\" fill=\"white\" letter-spacing=\"-0.02em\">M—</text></svg></span><span class=\"brand-name\">Marrow</span></a>\n            <button class=\"nav-toggle\" type=\"button\" data-mobile-nav-toggle aria-label=\"Toggle navigation\">Menu</button>\n            <nav class=\"nav-links\" data-mobile-nav-panel>\n              <a href=\"/\">Home</a><a href=\"#features\">Features</a><a href=\"#pricing\">Pricing</a><a href=\"#stories\">Stories</a><a href=\"#contact\">Contact</a>\n              \n              <div class=\"nav-actions\">\n                <a class=\"button button--primary\" href=\"#contact\">Start building</a><a class=\"button\" href=\"#pricing\">See pricing</a>\n              </div>\n            </nav>\n          </div>\n        </header>\n      \n\n        <section class=\"section hero hero--split\" id=\"hero\">\n          <div class=\"container hero-grid\">\n            <div>\n              <p class=\"eyebrow\">Nose‑to‑tail butchery and supper club in Lisbon</p>\n              <h1>Marrow</h1>\n              <p class=\"section-body\">Weekly changing set menus, butchery classes, and whole‑animal provenance from a single farm in Alentejo.</p>\n              <div class=\"action-row\">\n                <a class=\"button button--primary\" href=\"#contact\">Reserve a table</a><a class=\"button\" href=\"#features\">Explore classes</a>\n              </div>\n            </div>\n            <div class=\"hero-panel\">\n              \n              <div class=\"hero-chip\">Item 1</div>\n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section stats\" id=\"product-proof\">\n          <div class=\"container\">\n            \n            <h2>Design with the visual editor</h2>\n            <div class=\"stat-grid\">\n              <div class=\"stat-card\" data-reveal><span class=\"stat-card__label\"></span><strong class=\"stat-card__value\">Item 1</strong></div>\n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section\" id=\"features\">\n          <div class=\"container\">\n            \n            <h2>What Marrow offers</h2>\n            \n            <div class=\"card-grid\">\n              <article class=\"card\" data-reveal><h3>Weekly set menus</h3><p>Seasonal dishes crafted from whole animals, changing every week.</p></article><article class=\"card\" data-reveal><h3>Butchery classes</h3><p>Hands‑on workshops teaching nose‑to‑tail techniques.</p></article><article class=\"card\" data-reveal><h3>Farm‑direct provenance</h3><p>All meat sourced from a single Alentejo farm.</p></article><article class=\"card\" data-reveal><h3>Private dining</h3><p>Tailored experiences for groups of up to 12.</p></article><article class=\"card\" data-reveal><h3>Sustainable practices</h3><p>Zero waste philosophy embedded in every plate.</p></article><article class=\"card\" data-reveal><h3>Artisan cocktails</h3><p>Pairings designed by local mixologists.</p></article>\n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section pricing\" id=\"pricing\">\n          <div class=\"container\">\n            \n            <h2>Choose your experience</h2>\n            \n            <div class=\"pricing-grid\">\n              \n                  <article class=\"pricing-card\" data-reveal>\n                    <h3>Dinner</h3>\n                    <div class=\"price\">€45</div>\n                    <p>Weekly set menu for two.</p>\n                    <ul>\n                      <li>Seasonal tasting</li><li>Wine pairing optional</li><li>Reserve up to 30 days</li>\n                    </ul>\n                  </article>\n                \n                  <article class=\"pricing-card\" data-reveal>\n                    <h3>Class</h3>\n                    <div class=\"price\">€120</div>\n                    <p>Full‑day butchery workshop.</p>\n                    <ul>\n                      <li>All tools provided</li><li>Take‑home cuts</li><li>Small group (max 6)</li>\n                    </ul>\n                  </article>\n                \n                  <article class=\"pricing-card\" data-reveal>\n                    <h3>Private</h3>\n                    <div class=\"price\">Custom</div>\n                    <p>Tailored private dining experience.</p>\n                    <ul>\n                      <li>Custom menu</li><li>On‑site chef</li><li>Exclusive venue</li>\n                    </ul>\n                  </article>\n                \n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section logo-cloud\" id=\"stories\">\n          <div class=\"container\">\n            <h2>Stories</h2>\n            <div class=\"logo-row\">\n              <span class=\"logo-pill\">Item 1</span><span class=\"logo-pill\">Item 2</span><span class=\"logo-pill\">Item 3</span>\n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section testimonials\" id=\"testimonials\">\n          <div class=\"container\">\n            <h2>What partners say</h2>\n            <div class=\"card-grid\">\n              <blockquote class=\"card quote-card\" data-reveal>\n                    <p>“Marrow’s approach transformed our dining experience – reservations jumped 30% after the first month.”</p>\n                    <footer>\n                      <strong>Chef Ana Silva, Time Out Lisbon</strong>\n                      \n                    </footer>\n                  </blockquote><blockquote class=\"card quote-card\" data-reveal>\n                    <p>“The butchery workshops are the most hands‑on learning we’ve seen in the city.”</p>\n                    <footer>\n                      <strong>Marco Duarte, The Foodie</strong>\n                      \n                    </footer>\n                  </blockquote>\n            </div>\n          </div>\n        </section>\n      \n\n        <section class=\"section cta\" id=\"final-cta\">\n          <div class=\"container cta-shell\">\n            <div>\n              <h2>Ready to taste the difference?</h2>\n              \n            </div>\n            <div class=\"action-row\">\n              <a class=\"button button--primary\" href=\"#contact\">Reserve a table</a><a class=\"button\" href=\"#features\">Join a class</a>\n            </div>\n          </div>\n        </section>\n      \n\n        <footer class=\"site-footer\" id=\"footer\">\n          <div class=\"container footer-shell\">\n            <div class=\"footer-meta\">\n              <div>\n                <div class=\"footer-brand\">\n                  <span class=\"brand-logo\" aria-hidden=\"false\" style=\"height:36px\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 160 48\" role=\"img\" aria-label=\"Marrow — a nose-to-tail butchery and supper club in Lisbon logo\"><rect x=\"0\" y=\"0\" width=\"160\" height=\"48\" rx=\"14\" fill=\"hsl(26 78% 46%)\"/><text x=\"80\" y=\"31\" text-anchor=\"middle\" font-family=\"Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif\" font-size=\"20\" font-weight=\"800\" fill=\"white\" letter-spacing=\"-0.02em\">M—</text></svg></span>\n                  <strong>Marrow</strong>\n                </div>\n                \n              </div>\n            </div>\n            <nav c