{
  "name": "medusa-backend",
  "version": "0.1.0",
  "description": "Per-tenant Medusa v2 backend image used by ship-fast's container-per-tenant multi-tenancy. One image, many running containers — each container is a single ship-fast session's isolated Medusa.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "develop": "medusa develop",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.js"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.13.5",
    "@medusajs/framework": "2.13.5",
    "@medusajs/medusa": "2.13.5",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/knex": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/postgresql": "6.4.16",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.5",
    "@swc/core": "^1.5.7",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
